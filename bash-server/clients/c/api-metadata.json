        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_SERVER"]
      },
      {
        "name": "bc_alias_unset",
        "prototype": "int bc_alias_unset(bc_client_t *c, const char *name)",
