        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_TIMEOUT"]
      },
      {
        "name": "bc_var_set",
        "prototype": "int bc_var_set(bc_client_t *c, const char *name, const char *value)",
        "description": "Set a shell variable",
        "returns": "int",
        "parameters": [
          { "name": "c",     "type": "bc_client_t *", "nullable": false },
          { "name": "name",  "type": "const char *",  "nullable": false },
          { "name": "value", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_SERVER"]
      },
      {
        "name": "bc_var_set_attr",
        "prototype": "int bc_var_set_attr(bc_client_t *c, const char *name, const char *value, const char *attributes)",
        "description": "Set a shell variable with attributes",
        "returns": "int",
        "parameters": [
          { "name": "c",          "type": "bc_client_t *", "nullable": false },
          { "name": "name",       "type": "const char *",  "nullable": false },
          { "name": "value",      "type": "const char *",  "nullable": false },
          { "name": "attributes", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_SERVER"]
      },
      {
        "name": "bc_var_unset",
        "prototype": "int bc_var_unset(bc_client_t *c, const char *name)",
        "description": "Unset a shell variable",
        "returns": "int",
        "parameters": [
          { "name": "c",    "type": "bc_client_t *", "nullable": false },
          { "name": "name", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_SERVER"]
      },
      {
        "name": "bc_func_get",
        "prototype": "char *bc_func_get(bc_client_t *c, const char *name)",
        "description": "Get body of a shell function",
