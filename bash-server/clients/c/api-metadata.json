        "returns_null_on_error": true,
        "free_with": "bc_free",
        "parameters": [
          { "name": "c",    "type": "bc_client_t *", "nullable": false },
          { "name": "name", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_TIMEOUT"]
      },
      {
        "name": "bc_alias_set",
        "prototype": "int bc_alias_set(bc_client_t *c, const char *name, const char *expansion)",
