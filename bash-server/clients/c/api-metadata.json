        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_TIMEOUT"]
      },
      {
        "name": "bc_func_set",
        "prototype": "int bc_func_set(bc_client_t *c, const char *name, const char *body)",
        "description": "Define or replace a shell function",
