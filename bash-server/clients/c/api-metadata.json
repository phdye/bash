{
  "package": {
    "name": "libbashclient",
    "version": "0.1.0",
    "api_version": 1,
    "language": "c",
    "standard": "c99",
    "license": "GPL-3.0-or-later",
    "header": "bashclient.h",
    "link_flag": "-lbashclient",
    "shared_library": "libbashclient.so",
    "static_library": "libbashclient.a",
    "pkg_config": "libbashclient",
    "thread_safe": false,
    "dependencies": []
  },
  "error_codes": [
    { "name": "BC_OK",            "value":  0, "description": "Success" },
    { "name": "BC_ERR_AUTH",      "value": -1, "description": "Authentication failed" },
    { "name": "BC_ERR_PROTOCOL",  "value": -2, "description": "Protocol error" },
    { "name": "BC_ERR_TIMEOUT",   "value": -3, "description": "Operation timed out" },
    { "name": "BC_ERR_TRANSPORT", "value": -4, "description": "Transport error" },
    { "name": "BC_ERR_SERVER",    "value": -5, "description": "Server error" },
    { "name": "BC_ERR_NOMEM",     "value": -6, "description": "Out of memory" },
    { "name": "BC_ERR_PARAM",     "value": -7, "description": "Invalid parameter" }
  ],
  "constants": [
    { "name": "BC_API_VERSION",      "value": 1,       "type": "int" },
    { "name": "BC_VERSION_STRING",   "value": "0.1.0", "type": "string" },
    { "name": "BC_TRANSPORT_SOCKET", "value": 0,       "type": "int" },
    { "name": "BC_TRANSPORT_STDIO",  "value": 1,       "type": "int" },
    { "name": "BC_TRANSPORT_FD",     "value": 2,       "type": "int" },
    { "name": "BC_TRANSPORT_PIPE",   "value": 3,       "type": "int" },
    { "name": "BC_WIRE_BINARY",      "value": 0,       "type": "int" },
    { "name": "BC_WIRE_NDJSON",      "value": 1,       "type": "int" }
  ],
  "structs": [
    {
      "name": "bc_client_t",
      "opaque": true,
      "description": "Client connection handle"
    },
    {
      "name": "bc_opts_t",
      "opaque": false,
      "description": "Connection options",
      "init_macro": "BC_OPTS_INIT",
      "fields": [
        { "name": "transport",          "type": "int",          "description": "BC_TRANSPORT_* constant" },
        { "name": "socket_path",        "type": "const char *", "description": "Unix socket path" },
        { "name": "auth_token",         "type": "const char *", "description": "Authentication token" },
        { "name": "stdio_command",      "type": "const char *", "description": "Command for stdio transport" },
        { "name": "fd_read",            "type": "int",          "description": "Read fd for fd transport" },
        { "name": "fd_write",           "type": "int",          "description": "Write fd for fd transport" },
        { "name": "pipe_name",          "type": "const char *", "description": "Named pipe path" },
        { "name": "connect_timeout_ms", "type": "int",          "description": "Connection timeout (ms)" },
        { "name": "read_timeout_ms",    "type": "int",          "description": "Read timeout (ms)" },
        { "name": "write_timeout_ms",   "type": "int",          "description": "Write timeout (ms)" },
        { "name": "protocol_version",   "type": "int",          "description": "Requested protocol version" },
        { "name": "wire_format",        "type": "int",          "description": "BC_WIRE_* constant" }
      ]
    },
    {
      "name": "bc_eval_result_t",
      "opaque": false,
      "description": "Command evaluation result",
      "free_function": "bc_eval_result_free",
      "fields": [
        { "name": "stdout_data", "type": "char *", "description": "Captured stdout (never NULL)" },
        { "name": "stderr_data", "type": "char *", "description": "Captured stderr (never NULL)" },
        { "name": "exit_code",   "type": "int",    "description": "Exit code of last command" }
      ]
    },
    {
      "name": "bc_var_info_t",
      "opaque": false,
      "description": "Variable with attributes",
      "fields": [
        { "name": "name",           "type": "char *",  "description": "Variable name" },
        { "name": "value",          "type": "char *",  "description": "Variable value" },
        { "name": "attributes",     "type": "char **", "description": "Attribute string array" },
        { "name": "num_attributes", "type": "int",     "description": "Number of attributes" }
      ]
    },
    {
      "name": "bc_pre_command_event_t",
      "opaque": false,
      "description": "Pre-command observer event",
      "fields": [
        { "name": "seq",         "type": "int",       "description": "Sequence number" },
        { "name": "timestamp",   "type": "long long", "description": "Unix timestamp (ms)" },
        { "name": "command",     "type": "char *",    "description": "Command text" },
        { "name": "cwd",         "type": "char *",    "description": "Current working directory" },
        { "name": "line_number", "type": "int",       "description": "Source line number" },
        { "name": "is_subshell", "type": "int",       "description": "1 if in subshell" },
        { "name": "is_async",    "type": "int",       "description": "1 if async command" }
      ]
    },
    {
      "name": "bc_post_command_event_t",
      "opaque": false,
      "description": "Post-command observer event",
      "fields": [
        { "name": "seq",           "type": "int",       "description": "Sequence number" },
        { "name": "timestamp",     "type": "long long", "description": "Unix timestamp (ms)" },
        { "name": "command",       "type": "char *",    "description": "Command text" },
        { "name": "exit_status",   "type": "int",       "description": "Exit status" },
        { "name": "signal_number", "type": "int",       "description": "Signal number (0 if none)" },
        { "name": "duration_ms",   "type": "int",       "description": "Execution duration (ms)" }
      ]
    },
    {
      "name": "bc_breakpoint_t",
      "opaque": false,
      "description": "Breakpoint descriptor",
      "free_function": "bc_breakpoints_free",
      "fields": [
        { "name": "id",        "type": "int",    "description": "Breakpoint ID" },
        { "name": "kind",      "type": "char *", "description": "command, line, or function" },
        { "name": "enabled",   "type": "int",    "description": "1 if enabled" },
        { "name": "hit_count", "type": "int",    "description": "Times hit" },
        { "name": "pattern",   "type": "char *", "description": "Match pattern" },
        { "name": "line",      "type": "int",    "description": "Line number (0 if N/A)" },
        { "name": "condition", "type": "char *", "description": "Condition expr (NULL if none)" }
      ]
    },
    {
      "name": "bc_break_hit_event_t",
      "opaque": false,
      "description": "Breakpoint hit event",
      "fields": [
        { "name": "line",    "type": "int",    "description": "Line number" },
        { "name": "command", "type": "char *", "description": "Command at breakpoint" },
        { "name": "depth",   "type": "int",    "description": "Call depth" }
      ]
    },
    {
      "name": "bc_debug_status_t",
      "opaque": false,
      "description": "Debugger status",
      "free_function": "bc_debug_status_free",
      "fields": [
        { "name": "active",      "type": "int",    "description": "1 if debugger enabled" },
        { "name": "mode",        "type": "char *", "description": "running, stopped, disabled" },
        { "name": "breakpoints", "type": "int",    "description": "Number of breakpoints" },
        { "name": "depth",       "type": "int",    "description": "Current call depth" }
      ]
    },
    {
      "name": "bc_pty_info_t",
      "opaque": false,
      "description": "PTY session info",
      "free_function": "bc_pty_info_free",
      "fields": [
        { "name": "rows",       "type": "int", "description": "Terminal rows" },
        { "name": "cols",       "type": "int", "description": "Terminal columns" },
        { "name": "pid",        "type": "int", "description": "Child PID" },
        { "name": "strip_ansi", "type": "int", "description": "1 if ANSI stripping on" }
      ]
    }
  ],
  "functions": {
    "connection": [
      {
        "name": "bc_connect",
        "prototype": "bc_client_t *bc_connect(const char *socket_path, const char *auth_token)",
        "description": "Connect to bash-server via Unix socket with auto-discovery",
        "returns": "bc_client_t *",
        "returns_null_on_error": true,
        "parameters": [
          { "name": "socket_path", "type": "const char *", "nullable": true },
          { "name": "auth_token",  "type": "const char *", "nullable": true }
        ],
        "errors": ["BC_ERR_TRANSPORT", "BC_ERR_AUTH", "BC_ERR_TIMEOUT", "BC_ERR_NOMEM"]
      },
      {
        "name": "bc_connect_opts",
        "prototype": "bc_client_t *bc_connect_opts(const bc_opts_t *opts)",
        "description": "Connect with full transport and option control",
        "returns": "bc_client_t *",
        "returns_null_on_error": true,
        "parameters": [
          { "name": "opts", "type": "const bc_opts_t *", "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_AUTH", "BC_ERR_TIMEOUT", "BC_ERR_NOMEM"]
      },
      {
        "name": "bc_close",
        "prototype": "void bc_close(bc_client_t *c)",
        "description": "Close connection and free all resources",
        "returns": "void",
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": true }
        ],
        "errors": []
      },
      {
        "name": "bc_ping",
        "prototype": "int bc_ping(bc_client_t *c)",
        "description": "Test server responsiveness",
        "returns": "int",
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_TIMEOUT"]
      },
      {
        "name": "bc_configure",
        "prototype": "int bc_configure(bc_client_t *c, const char *key, const char *value)",
        "description": "Set session configuration parameter",
        "returns": "int",
        "parameters": [
          { "name": "c",     "type": "bc_client_t *", "nullable": false },
          { "name": "key",   "type": "const char *",  "nullable": false },
          { "name": "value", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_SERVER", "BC_ERR_TRANSPORT"]
      },
      {
        "name": "bc_disconnect",
        "prototype": "int bc_disconnect(bc_client_t *c)",
        "description": "Graceful server disconnect",
        "returns": "int",
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT"]
      },
      {
        "name": "bc_get_fd",
        "prototype": "int bc_get_fd(bc_client_t *c)",
        "description": "Get underlying file descriptor for event loop integration",
        "returns": "int",
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": false }
        ],
        "errors": []
      },
      {
        "name": "bc_last_error",
        "prototype": "int bc_last_error(bc_client_t *c)",
        "description": "Get error code from last operation",
        "returns": "int",
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": true }
        ],
        "errors": []
      },
      {
        "name": "bc_last_error_msg",
        "prototype": "const char *bc_last_error_msg(bc_client_t *c)",
        "description": "Get human-readable error message from last operation",
        "returns": "const char *",
        "returns_null_on_error": false,
        "parameters": [
          { "name": "c", "type": "bc_client_t *", "nullable": true }
        ],
        "errors": []
      }
    ],
    "command": [
      {
        "name": "bc_eval",
        "prototype": "bc_eval_result_t *bc_eval(bc_client_t *c, const char *command)",
        "description": "Evaluate a shell command and return captured output",
        "returns": "bc_eval_result_t *",
        "returns_null_on_error": true,
        "parameters": [
          { "name": "c",       "type": "bc_client_t *", "nullable": false },
          { "name": "command", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_TIMEOUT", "BC_ERR_SERVER", "BC_ERR_NOMEM"]
      },
      {
        "name": "bc_eval_stream",
        "prototype": "int bc_eval_stream(bc_client_t *c, const char *command, void (*on_stdout)(const char *, size_t, void *), void (*on_stderr)(const char *, size_t, void *), void (*on_complete)(int, void *), void *userdata)",
        "description": "Start streaming evaluation with incremental callbacks",
        "returns": "int",
        "parameters": [
          { "name": "c",           "type": "bc_client_t *", "nullable": false },
          { "name": "command",     "type": "const char *",  "nullable": false },
          { "name": "on_stdout",   "type": "callback",      "nullable": true },
          { "name": "on_stderr",   "type": "callback",      "nullable": true },
          { "name": "on_complete", "type": "callback",      "nullable": true },
          { "name": "userdata",    "type": "void *",        "nullable": true }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT"]
      }
    ],
    "state": [
      {
        "name": "bc_var_get",
        "prototype": "char *bc_var_get(bc_client_t *c, const char *name)",
        "description": "Get value of a shell variable",
        "returns": "char *",
        "returns_null_on_error": true,
        "free_with": "bc_free",
        "parameters": [
          { "name": "c",    "type": "bc_client_t *", "nullable": false },
