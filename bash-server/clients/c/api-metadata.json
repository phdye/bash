        "parameters": [
          { "name": "c",    "type": "bc_client_t *", "nullable": false },
          { "name": "name", "type": "const char *",  "nullable": false }
        ],
        "errors": ["BC_ERR_PARAM", "BC_ERR_TRANSPORT", "BC_ERR_SERVER"]
      },
      {
        "name": "bc_alias_get",
        "prototype": "char *bc_alias_get(bc_client_t *c, const char *name)",
        "description": "Get expansion text of a shell alias",
