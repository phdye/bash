<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BashServer.Client</RootNamespace>
    <PackageId>BashServer.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>bash-server contributors</Authors>
    <Description>C# client library for bash-server v2 NDJSON protocol. Provides async access to command evaluation, state management, observation, debugging, and PTY channels.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageTags>bash;shell;ndjson;ipc;client</PackageTags>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
