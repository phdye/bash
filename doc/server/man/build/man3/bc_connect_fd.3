.SH Parent process passing fd to child
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]
#include \f[B]<unistd.h>\f[R]
#include \f[B]<sys/socket.h>\f[R]

int main(void)
{
    int sv[2];

    \f[I]/* Create a connected socket pair */\f[R]
    \f[B]if\f[R] (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) < 0) {
        perror(\(dqsocketpair\(dq);
        \f[B]return\f[R] 1;
    }

    pid_t pid = fork();
    \f[B]if\f[R] (pid < 0) {
        perror(\(dqfork\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (pid == 0) {
        \f[I]/* Child: launch bash\-server on one end */\f[R]
        close(sv[0]);
        char fd_str[16];
        snprintf(fd_str, \f[B]sizeof\f[R](fd_str), \(dq%d\(dq, sv[1]);
        execlp(\(dqbash\-server\(dq, \(dqbash\-server\(dq,
               \(dq\-\-fd\(dq, fd_str, NULL);
        perror(\(dqexec\(dq);
        _exit(1);
    }

    \f[I]/* Parent: use the other end */\f[R]
    close(sv[1]);

    bc_client_t *client = bc_connect_fd(sv[0]);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect_fd\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqecho $$\(dq, &result) == BC_OK) {
        printf(\(dqserver PID: %s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
