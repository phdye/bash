.SH EXAMPLES
.SH Detect exit and print status
.IP
.EX
void on_exit(int exit_code, void *userdata)
{
    int *exited = (int *)userdata;
    *exited = 1;

    \f[B]if\f[R] (exit_code == 0) {
        printf(\(dqPTY child exited normally\(rsn\(dq);
    } \f[B]else\f[R] \f[B]if\f[R] (exit_code > 128) {
        printf(\(dqPTY child killed by signal %d\(rsn\(dq, exit_code \- 128);
    } \f[B]else\f[R] {
        printf(\(dqPTY child exited with code %d\(rsn\(dq, exit_code);
    }
}

int main(void)
{
    bc_client_t *c = bc_connect(sock_path, token);
    bc_pty_spawn(c, 24, 80, NULL, 0, NULL);

    int exited = 0;
    bc_pty_on_exit(c, on_exit, &exited);

    \f[I]/* Send exit command */\f[R]
    bc_pty_write(c, \(dqexit 42\(rsn\(dq, 8);

    \f[I]/* Poll until exit */\f[R]
    \f[B]while\f[R] (!exited) {
        bc_poll(c, 100);
    }

    bc_pty_close(c);
    bc_disconnect(c);
}
.EE
.SH Combined output and exit handling
.IP
.EX
static int g_exited = 0;

void on_output(const char *data, size_t len, void *ud)
{
    fwrite(data, 1, len, stdout);
}

void on_exit(int code, void *ud)
{
    g_exited = 1;
    printf(\(dq\(rsn\-\-\- Process exited: %d \-\-\-\(rsn\(dq, code);
}

int main(void)
{
    bc_client_t *c = bc_connect(sock_path, token);
    bc_pty_spawn(c, 24, 80, NULL, 0, NULL);

    bc_pty_on_output(c, on_output, NULL);
    bc_pty_on_exit(c, on_exit, NULL);

    bc_pty_write(c, \(dqecho hello && exit\(rsn\(dq, 19);

    \f[B]while\f[R] (!g_exited)
        bc_poll(c, 100);

    bc_pty_close(c);
    bc_disconnect(c);
}
.EE
.SH Automatic respawn on exit
.IP
.EX
void on_exit_respawn(int code, void *userdata)
{
    bc_client_t *c = (bc_client_t *)userdata;
    fprintf(stderr, \(dqShell exited (%d), respawning...\(rsn\(dq, code);
    bc_pty_close(c);
    bc_pty_spawn(c, 24, 80, NULL, 0, NULL);
}
