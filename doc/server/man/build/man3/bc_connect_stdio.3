.SH Launch bash\-server over SSH
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(int argc, char *argv[])
{
    const char *host = argc > 1 ? argv[1] : \(dqlocalhost\(dq;
    const char *cmd[] = {
        \(dqssh\(dq, \(dq\-o\(dq, \(dqBatchMode=yes\(dq,
        host, \(dqbash\-server\(dq, \(dq\-\-stdio\(dq,
        NULL
    };

    bc_client_t *client = bc_connect_stdio(cmd);
    \f[B]if\f[R] (!client) {
        fprintf(stderr, \(dqfailed to connect via ssh to %s: %s\(rsn\(dq,
                host, strerror(errno));
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqhostname; whoami\(dq, &result) == BC_OK) {
        printf(\(dqhost output:\(rsn%s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
