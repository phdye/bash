    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth failed: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
