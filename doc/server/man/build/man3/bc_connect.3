.SH Connection with explicit socket path
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(int argc, char *argv[])
{
    const char *sock = \(dq/tmp/bash\-server\-1000/sock\(dq;
    bc_client_t *client;

    \f[B]if\f[R] (argc > 1)
        sock = argv[1];

    client = bc_connect(sock);
    \f[B]if\f[R] (!client) {
        fprintf(stderr, \(dqbc_connect(%s): %s\(rsn\(dq, sock, strerror(errno));
        \f[B]return\f[R] 1;
    }

    printf(\(dqconnected to %s\(rsn\(dq, sock);

    \f[I]/* Authenticate */\f[R]
    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Evaluate a command */\f[R]
    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqecho hello\(dq, &result) == BC_OK) {
        printf(\(dqstdout: %s\(rsn\(dq, result.stdout_data);
        printf(\(dqexit:   %d\(rsn\(dq, result.exit_code);
        bc_eval_result_free(&result);
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
.EE
.SH Connection with retry loop
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<unistd.h>\f[R]
#include \f[B]<errno.h>\f[R]

bc_client_t *connect_with_retry(const char *path, int max_attempts)
{
    bc_client_t *client;

    \f[B]for\f[R] (int i = 0; i < max_attempts; i++) {
        client = bc_connect(path);
        \f[B]if\f[R] (client)
            \f[B]return\f[R] client;

        \f[B]if\f[R] (errno != ECONNREFUSED && errno != ENOENT)
            \f[B]break\f[R];  \f[I]/* non\-retryable error */\f[R]

        fprintf(stderr, \(dqattempt %d/%d: %s\(rsn\(dq,
                i + 1, max_attempts, strerror(errno));
        sleep(1);
    }

    \f[B]return\f[R] NULL;
}
