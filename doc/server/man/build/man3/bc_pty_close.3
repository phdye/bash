.SH ERRORS
Even if the close fails at the protocol level (e.g., transport error),
the client\-side PTY state is reset so that a subsequent
\f[CR]bc_pty_spawn(3)\f[R] call can attempt a fresh session.
.PP
If the connection is lost before the close acknowledgement arrives, the
server\-side cleanup still occurs (the child process is reaped when the
session file descriptors close).
.SH EXAMPLES
.SH Close after interactive session
.IP
.EX
\f[I]/* Spawn and interact with PTY */\f[R]
bc_pty_spawn(c, 24, 80, NULL, 0, NULL);
bc_pty_write(c, \(dqexit\(rsn\(dq, 5);

\f[I]/* Give the shell time to exit gracefully */\f[R]
bc_poll(c, 1000);

\f[I]/* Close the PTY session */\f[R]
int rc = bc_pty_close(c);
\f[B]if\f[R] (rc != BC_OK) {
    fprintf(stderr, \(dqclose failed: %d\(rsn\(dq, rc);
}
.EE
.SH Force\-close a hung process
.IP
.EX
\f[I]/* Signal first, then close */\f[R]
bc_pty_signal(c, \(dqSIGKILL\(dq);
bc_poll(c, 500);
bc_pty_close(c);
.EE
.SH Clean shutdown pattern
.IP
.EX
void cleanup_pty(bc_client_t *c)
{
    \f[I]/* Send Ctrl\-D to signal EOF */\f[R]
    bc_pty_write(c, \(dq\(rsx04\(dq, 1);

    \f[I]/* Wait up to 2 seconds for graceful exit */\f[R]
    \f[B]for\f[R] (int i = 0; i < 20; i++) {
        bc_poll(c, 100);
        \f[B]if\f[R] (!bc_pty_active(c))
            \f[B]return\f[R];
    }

    \f[I]/* Force close if still running */\f[R]
    bc_pty_close(c);
}
