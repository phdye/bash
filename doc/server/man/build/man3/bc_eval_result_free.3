char *get_server_hostname(bc_client_t *client)
{
    bc_eval_result_t result = {0};  \f[I]/* zero\-init for safety */\f[R]

    \f[B]if\f[R] (bc_eval(client, \(dqhostname \-f\(dq, &result) != BC_OK)
        \f[B]return\f[R] NULL;

    \f[B]if\f[R] (result.exit_code != 0) {
        bc_eval_result_free(&result);
        \f[B]return\f[R] NULL;
    }

    \f[I]/* Take ownership of stdout_data */\f[R]
    char *hostname = result.stdout_data;
    result.stdout_data = NULL;  \f[I]/* prevent double\-free */\f[R]

    \f[I]/* Strip trailing newline */\f[R]
    size_t len = strlen(hostname);
    \f[B]if\f[R] (len > 0 && hostname[len\-1] == \(aq\(rsn\(aq)
        hostname[len\-1] = \(aq\(rs0\(aq;

    \f[I]/* Free the rest (stderr_data) */\f[R]
    bc_eval_result_free(&result);

    \f[B]return\f[R] hostname;  \f[I]/* caller frees with bc_free */\f[R]
}

