.SH ERRORS
If the child process has already exited, the resize request may succeed
at the protocol level (the ioctl still applies to the PTY master) but
has no practical effect.
.SH EXAMPLES
.SH Respond to local terminal resize
.IP
.EX
#include \f[B]<signal.h>\f[R]
#include \f[B]<sys/ioctl.h>\f[R]

static bc_client_t *g_client;

void handle_winch(int sig)
{
    \f[B]struct\f[R] winsize ws;
    \f[B]if\f[R] (ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws) == 0) {
        bc_pty_resize(g_client, ws.ws_row, ws.ws_col);
    }
}

int main(void)
{
    g_client = bc_connect(sock_path, token);
    \f[I]/* ... authenticate, spawn PTY ... */\f[R]

    \f[B]struct\f[R] sigaction sa = { .sa_handler = handle_winch };
    sigaction(SIGWINCH, &sa, NULL);

    \f[I]/* ... event loop ... */\f[R]
}
