.SH EXAMPLES
.SH Command breakpoint
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);
    bc_debug_enable(c);

    \f[I]/* Break on any command containing \(dqrm\(dq */\f[R]
    int bp = bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqrm\(dq, \-1, NULL);
    \f[B]if\f[R] (bp < 0) {
        fprintf(stderr, \(dqadd_breakpoint failed: %d\(rsn\(dq, bp);
    } \f[B]else\f[R] {
        printf(\(dqBreakpoint %d: command matching \(aqrm\(aq\(rsn\(dq, bp);
    }

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Line breakpoint with condition
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);
    bc_debug_enable(c);

    \f[I]/* Break at line 25 only when $count > 10 */\f[R]
    int bp = bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 25,
                                     \(dq[ $count \-gt 10 ]\(dq);
    printf(\(dqConditional breakpoint %d at line 25\(rsn\(dq, bp);

    \f[I]/* Break on function calls matching \(dqcleanup\(dq */\f[R]
    int bp2 = bc_debug_add_breakpoint(c, \(dqfunction\(dq, \(dqcleanup\(dq,
                                      \-1, NULL);
    printf(\(dqFunction breakpoint %d for \(aqcleanup\(aq\(rsn\(dq, bp2);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
