.SH EXAMPLES
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

void show_breakpoints(bc_client_t *c)
{
    bc_breakpoint_t *bps = NULL;
    int count = 0;

    int rc = bc_debug_list_breakpoints(c, &bps, &count);
    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqlist failed: %d\(rsn\(dq, rc);
        \f[B]return\f[R];
    }

    printf(\(dqBreakpoints (%d):\(rsn\(dq, count);
    \f[B]for\f[R] (int i = 0; i < count; i++) {
        printf(\(dq  #%d [%s] %s\(dq, bps[i].id, bps[i].kind,
               bps[i].enabled ? \(dqenabled\(dq : \(dqdisabled\(dq);

        \f[B]if\f[R] (bps[i].pattern)
            printf(\(dq pattern=\(aq%s\(aq\(dq, bps[i].pattern);
        \f[B]if\f[R] (bps[i].line > 0)
            printf(\(dq line=%d\(dq, bps[i].line);
        \f[B]if\f[R] (bps[i].condition)
            printf(\(dq if(%s)\(dq, bps[i].condition);

        printf(\(dq hits=%d\(rsn\(dq, bps[i].hit_count);
    }

    bc_breakpoint_list_free(bps, count);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);
    bc_debug_enable(c);

    bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho\(dq, \-1, NULL);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 10, \(dq[ $x \-gt 5 ]\(dq);
    bc_debug_add_breakpoint(c, \(dqfunction\(dq, \(dqcleanup\(dq, \-1, NULL);

    show_breakpoints(c);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
