.SH EXAMPLES
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

void show_debug_status(bc_client_t *c)
{
    bc_debug_status_t st;

    int rc = bc_debug_status(c, &st);
    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqstatus query failed: %d\(rsn\(dq, rc);
        \f[B]return\f[R];
    }

    printf(\(dqDebugger: %s\(rsn\(dq, st.active ? \(dqactive\(dq : \(dqinactive\(dq);
    \f[B]if\f[R] (st.active) {
        printf(\(dq  Mode:        %s\(rsn\(dq, st.mode);
        printf(\(dq  Breakpoints: %d\(rsn\(dq, st.breakpoints);
        printf(\(dq  Depth:       %d\(rsn\(dq, st.depth);
    }

    bc_debug_status_free(&st);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    \f[I]/* Status before enabling */\f[R]
    show_debug_status(c);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho\(dq, \-1, NULL);

    \f[I]/* Status after enabling with breakpoint */\f[R]
    show_debug_status(c);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
