.SH EXAMPLES
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);
    bc_debug_enable(c);

    \f[I]/* Add two breakpoints */\f[R]
    int bp1 = bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqrm\(dq, \-1, NULL);
    int bp2 = bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 42, NULL);
    printf(\(dqAdded breakpoints %d and %d\(rsn\(dq, bp1, bp2);

    \f[I]/* Remove the first one */\f[R]
    int rc = bc_debug_remove_breakpoint(c, bp1);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqBreakpoint %d removed\(rsn\(dq, bp1);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqRemove failed: %d\(rsn\(dq, rc);
    }

    \f[I]/* Attempting to remove again fails */\f[R]
    rc = bc_debug_remove_breakpoint(c, bp1);
    \f[B]if\f[R] (rc == BC_ERR_SERVER)
        printf(\(dqBreakpoint %d already removed\(rsn\(dq, bp1);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
