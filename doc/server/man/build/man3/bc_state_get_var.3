.SH EXAMPLES
.SH Retrieve and print a variable
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *client;
    bc_var_info_t info;
    int rc;

    client = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!client) {
        fprintf(stderr, \(dqconnection failed\(rsn\(dq);
        \f[B]return\f[R] 1;
    }

    rc = bc_state_get_var(client, \(dqPATH\(dq, &info);
    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqget_var failed: %d\(rsn\(dq, rc);
        bc_disconnect(client);
        \f[B]return\f[R] 1;
    }

    printf(\(dqname:  %s\(rsn\(dq, info.name);
    printf(\(dqvalue: %s\(rsn\(dq, info.value);
    \f[B]for\f[R] (int i = 0; i < info.num_attributes; i++)
        printf(\(dqattr:  %s\(rsn\(dq, info.attributes[i]);

    bc_var_info_free(&info);
    bc_disconnect(client);
    \f[B]return\f[R] 0;
}
