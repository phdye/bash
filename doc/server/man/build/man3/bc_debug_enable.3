#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;

    \f[B]if\f[R] (bc_auth(c, \(dqmytoken\(dq) != BC_OK) {
        bc_disconnect(c);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Enable the debugger */\f[R]
    int rc = bc_debug_enable(c);
    \f[B]if\f[R] (rc != BC_OK) {
