.SH Closing a stdio\-transport connection
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(void)
{
    const char *argv[] = {\(dqbash\-server\(dq, \(dq\-\-stdio\(dq, NULL};

    bc_client_t *client = bc_connect_stdio(argv);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect_stdio\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqecho goodbye\(dq, &result) == BC_OK) {
        printf(\(dq%s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    \f[I]/* This terminates the bash\-server subprocess */\f[R]
    bc_close(client);

    \f[I]/* client pointer is now invalid \-\- do not use */\f[R]
    \f[B]return\f[R] 0;
}
