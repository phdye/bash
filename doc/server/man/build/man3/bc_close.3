.SH Cleanup helper with NULL safety
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

\f[B]typedef\f[R] \f[B]struct\f[R] {
    bc_client_t *client;
    char *buffer;
    FILE *logfile;
} app_context_t;

void cleanup(app_context_t *ctx)
{
    \f[I]/* bc_close is safe to call with NULL */\f[R]
    bc_close(ctx\->client);
    ctx\->client = NULL;

    free(ctx\->buffer);
    ctx\->buffer = NULL;

    \f[B]if\f[R] (ctx\->logfile) {
        fclose(ctx\->logfile);
        ctx\->logfile = NULL;
    }
}

int main(void)
{
    app_context_t ctx = {0};

    ctx.client = bc_connect(NULL);
    \f[B]if\f[R] (!ctx.client) {
        perror(\(dqbc_connect\(dq);
        cleanup(&ctx);
        \f[B]return\f[R] 1;
