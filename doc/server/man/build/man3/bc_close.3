    \f[B]if\f[R] (bc_auth(ctx.client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(ctx.client));
        cleanup(&ctx);
        \f[B]return\f[R] 1;
    }

    \f[I]/* ... use the connection ... */\f[R]

    cleanup(&ctx);
    \f[B]return\f[R] 0;
}
