#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *client;
    char *json = NULL;
    int rc;

    client = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!client)
        \f[B]return\f[R] 1;

    rc = bc_state_inspect(client, \(dqvars\(dq, &json);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqVariables:\(rsn%s\(rsn\(dq, json);
        bc_free(json);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqinspect failed: %d\(rsn\(dq, rc);
    }

    bc_disconnect(client);
    \f[B]return\f[R] 0;
}
