.SH EXAMPLES
.SH Set an EXIT trap
.IP
.EX
int rc = bc_state_set_trap(client, \(dqEXIT\(dq,
                           \(dqecho \(aqsession ending\(aq\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_trap failed: %d\(rsn\(dq, rc);
.EE
.SH Set a SIGINT trap
.IP
.EX
int rc = bc_state_set_trap(client, \(dqSIGINT\(dq,
                           \(dqecho \(aqinterrupted\(aq; exit 130\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_trap failed: %d\(rsn\(dq, rc);
.EE
.SH Set an ERR trap for error logging
.IP
.EX
int rc = bc_state_set_trap(client, \(dqERR\(dq,
    \(dqecho \(rs\(dqError in command: $BASH_COMMAND\(rs\(dq >&2\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_trap failed: %d\(rsn\(dq, rc);
.EE
.SH Replace an existing trap
.IP
.EX
\f[I]/* Set initial trap */\f[R]
bc_state_set_trap(client, \(dqEXIT\(dq, \(dqecho \(aqgoodbye\(aq\(dq);

\f[I]/* Replace with a different command */\f[R]
int rc = bc_state_set_trap(client, \(dqEXIT\(dq,
                           \(dqrm \-f /tmp/lockfile; echo \(aqdone\(aq\(dq);
assert(rc == BC_OK);
.EE
.SH Set a DEBUG trap for tracing
.IP
.EX
int rc = bc_state_set_trap(client, \(dqDEBUG\(dq,
    \(dqecho \(rs\(dq+ $BASH_COMMAND\(rs\(dq >&2\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_trap failed: %d\(rsn\(dq, rc);
.EE
