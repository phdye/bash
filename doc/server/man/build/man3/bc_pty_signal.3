.SH ERRORS
If the child process has already exited, the server returns an error and
this function returns \f[CR]BC_ERR_SERVER\f[R].
The client should use the \f[CR]bc_pty_on_exit(3)\f[R] callback to
detect child termination rather than relying on signal delivery failure.
.PP
Unrecognized signal names cause the server to respond with an error,
resulting in \f[CR]BC_ERR_PROTOCOL\f[R].
.SH EXAMPLES
.SH Interrupt a running command
.IP
.EX
int rc = bc_pty_signal(c, \(dqSIGINT\(dq);
\f[B]if\f[R] (rc != BC_OK) {
    fprintf(stderr, \(dqsignal failed: %d\(rsn\(dq, rc);
}
.EE
.SH Graceful shutdown sequence
.IP
.EX
\f[I]/* Try SIGTERM first */\f[R]
int rc = bc_pty_signal(c, \(dqSIGTERM\(dq);
\f[B]if\f[R] (rc != BC_OK) {
    \f[I]/* Process may have already exited */\f[R]
    \f[B]goto\f[R] cleanup;
}

\f[I]/* Wait briefly for exit */\f[R]
\f[B]for\f[R] (int i = 0; i < 10; i++) {
    bc_poll(c, 100);  \f[I]/* 100ms poll */\f[R]
    \f[B]if\f[R] (pty_exited)
        \f[B]goto\f[R] cleanup;
}

\f[I]/* Force kill */\f[R]
bc_pty_signal(c, \(dqSIGKILL\(dq);

cleanup:
    bc_pty_close(c);
.EE
.SH Suspend and resume
.IP
.EX
bc_pty_signal(c, \(dqSIGTSTP\(dq);
\f[I]/* ... do other work ... */\f[R]
bc_pty_signal(c, \(dqSIGCONT\(dq);
.EE
