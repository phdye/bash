#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

\f[I]/* Track slow commands */\f[R]
\f[B]typedef\f[R] \f[B]struct\f[R] {
    int threshold_ms;
    int slow_count;
} perf_monitor_t;

static void check_duration(const bc_post_command_event_t *ev,
                           void *ud)
{
    perf_monitor_t *mon = (perf_monitor_t *)ud;

    \f[B]if\f[R] (ev\->duration_ms > mon\->threshold_ms) {
        fprintf(stderr, \(dqSLOW [%dms]: %s (exit=%d)\(rsn\(dq,
                ev\->duration_ms, ev\->command, ev\->exit_status);
        mon\->slow_count++;
    }

    \f[B]if\f[R] (ev\->signal_number != 0) {
        fprintf(stderr, \(dqKILLED by signal %d: %s\(rsn\(dq,
                ev\->signal_number, ev\->command);
    }
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    perf_monitor_t mon = { .threshold_ms = 100, .slow_count = 0 };

    \f[I]/* Register callback and subscribe */\f[R]
    bc_observe_on_post_command(c, check_duration, &mon);
    bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);

    \f[I]/* Execute commands */\f[R]
    bc_eval(c, \(dqsleep 0.2\(dq, NULL, NULL, NULL);
    bc_eval(c, \(dqecho fast\(dq, NULL, NULL, NULL);
    bc_eval(c, \(dqsleep 0.5\(dq, NULL, NULL, NULL);

    \f[I]/* Process all pending events */\f[R]
    \f[B]while\f[R] (bc_poll(c, 1000) > 0)
        ;

    printf(\(dqDetected %d slow commands\(rsn\(dq, mon.slow_count);

    \f[I]/* Clean up */\f[R]
    bc_observe_on_post_command(c, NULL, NULL);
    bc_observe_unsubscribe(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
