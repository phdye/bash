.SH RETURN VALUE
None (\f[CR]void\f[R]).
.SH ERRORS
This function does not report errors.
Passing a pointer not allocated by the library results in undefined
behavior (same as \f[CR]free(3)\f[R] with an invalid pointer).
.SH EXAMPLES
.SH Freeing a string from the API
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqecho hello\(dq, &result) == BC_OK) {
        printf(\(dq%s\(dq, result.stdout_data);

        \f[I]/* Free individual fields with bc_free */\f[R]
        bc_free(result.stdout_data);
        bc_free(result.stderr_data);

        \f[I]/* Or equivalently, use bc_eval_result_free */\f[R]
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
.EE
.SH NULL safety
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]

void example(void)
{
    void *ptr = NULL;

    \f[I]/* Safe \-\- no\-op when ptr is NULL */\f[R]
    bc_free(ptr);
    bc_free(NULL);
}
.EE
.SH Correct usage in cleanup paths
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int process_commands(bc_client_t *client, const char **commands, int count)
{
    \f[B]for\f[R] (int i = 0; i < count; i++) {
        bc_eval_result_t result = {0};
        int rc = bc_eval(client, commands[i], &result);

        \f[B]if\f[R] (rc != BC_OK) {
            fprintf(stderr, \(dqcommand failed: %s\(rsn\(dq, bc_error(client));
            \f[I]/* result fields may be partially set \-\- safe to free */\f[R]
            bc_free(result.stdout_data);
            bc_free(result.stderr_data);
            \f[B]return\f[R] rc;
        }

        printf(\(dq$ %s\(rsn%s\(dq, commands[i], result.stdout_data);

        \f[B]if\f[R] (result.stderr_data && result.stderr_data[0])
            fprintf(stderr, \(dq%s\(dq, result.stderr_data);

        bc_free(result.stdout_data);
        bc_free(result.stderr_data);
    }

    \f[B]return\f[R] BC_OK;
}
.EE
