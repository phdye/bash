.SH EXAMPLES
.SH Set a simple variable
.IP
.EX
int rc = bc_state_set_var(client, \(dqGREETING\(dq, \(dqhello\(dq, NULL, 0);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_var failed: %d\(rsn\(dq, rc);
.EE
.SH Set an exported variable
.IP
.EX
const char *attrs[] = { \(dqexported\(dq };
int rc = bc_state_set_var(client, \(dqMY_PATH\(dq, \(dq/usr/local/bin\(dq,
                          attrs, 1);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_var failed: %d\(rsn\(dq, rc);
.EE
.SH Set a readonly integer variable
.IP
.EX
const char *attrs[] = { \(dqreadonly\(dq, \(dqinteger\(dq };
int rc = bc_state_set_var(client, \(dqMAX_RETRIES\(dq, \(dq5\(dq,
                          attrs, 2);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_var failed: %d\(rsn\(dq, rc);
.EE
.SH Update an existing variable\(cqs value
.IP
.EX
\f[I]/* Existing attributes are replaced, not merged */\f[R]
int rc = bc_state_set_var(client, \(dqCOUNTER\(dq, \(dq42\(dq, NULL, 0);
.EE
