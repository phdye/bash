.SH EXAMPLES
.SH Retrieve and display a function definition
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *client;
    char *def = NULL;
    int rc;

    client = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!client) {
        fprintf(stderr, \(dqconnection failed\(rsn\(dq);
        \f[B]return\f[R] 1;
    }

    \f[I]/* First, define a function via eval */\f[R]
    bc_eval(client, \(dqgreet() { echo \(rs\(dqhello $1\(rs\(dq; }\(dq,
            NULL, NULL, NULL);

    \f[I]/* Now retrieve its definition */\f[R]
    rc = bc_state_get_func(client, \(dqgreet\(dq, &def);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqgreet() %s\(rsn\(dq, def);
        bc_free(def);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqget_func failed: %d\(rsn\(dq, rc);
    }

    bc_disconnect(client);
    \f[B]return\f[R] 0;
}
