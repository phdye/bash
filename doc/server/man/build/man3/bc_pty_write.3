.SH Interactive relay loop
.IP
.EX
bc_pty_info_t info;
bc_pty_spawn(c, 24, 80, NULL, 0, &info);

\f[I]/* Set up output callback */\f[R]
bc_pty_on_output(c, my_output_handler, stdout);

\f[I]/* Read from local stdin, write to PTY */\f[R]
char buf[4096];
ssize_t n;
\f[B]while\f[R] ((n = read(STDIN_FILENO, buf, \f[B]sizeof\f[R](buf))) > 0) {
    int rc = bc_pty_write(c, buf, (size_t)n);
    \f[B]if\f[R] (rc != BC_OK)
        \f[B]break\f[R];
    bc_poll(c, 0);  \f[I]/* process any pending output */\f[R]
}
