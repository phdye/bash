#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<string.h>\f[R]

\f[I]/* Log all commands to a file */\f[R]
\f[B]typedef\f[R] \f[B]struct\f[R] {
    FILE *logfile;
    int   count;
} logger_t;

static void log_pre_command(const bc_pre_command_event_t *ev,
                            void *ud)
{
    logger_t *log = (logger_t *)ud;
    fprintf(log\->logfile,
            \(dq[%lld] #%d %s:%d %s%s%s\(rsn\(dq,
            ev\->timestamp, ev\->seq, ev\->cwd, ev\->line_number,
            ev\->command,
            ev\->is_subshell ? \(dq (subshell)\(dq : \(dq\(dq,
            ev\->is_async   ? \(dq (async)\(dq    : \(dq\(dq);
    fflush(log\->logfile);
    log\->count++;
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    logger_t log = { .logfile = fopen(\(dqcommands.log\(dq, \(dqa\(dq), .count = 0 };

    \f[I]/* Register the callback */\f[R]
    bc_observe_on_pre_command(c, log_pre_command, &log);

    \f[I]/* Subscribe to events */\f[R]
    bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);

    \f[I]/* Execute several commands */\f[R]
    bc_eval(c, \(dqcd /tmp\(dq, NULL, NULL, NULL);
    bc_eval(c, \(dqls \-la\(dq, NULL, NULL, NULL);
    bc_eval(c, \(dqecho done\(dq, NULL, NULL, NULL);

    \f[I]/* Process events \(em callbacks fire here */\f[R]
    \f[B]while\f[R] (bc_poll(c, 500) > 0)
        ;

    printf(\(dqLogged %d pre\-command events\(rsn\(dq, log.count);

    \f[I]/* Unregister callback */\f[R]
    bc_observe_on_pre_command(c, NULL, NULL);

    fclose(log.logfile);
    bc_observe_unsubscribe(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
