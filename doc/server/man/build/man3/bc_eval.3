.SH Checking command exit code
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;

    \f[I]/* BC_OK means the protocol exchange succeeded, NOT that the\f[R]
\f[I]     * command succeeded.  Check exit_code for command status. */\f[R]
    \f[B]if\f[R] (bc_eval(client, \(dqgrep \-q root /etc/passwd\(dq, &result) == BC_OK) {
        \f[B]if\f[R] (result.exit_code == 0)
            printf(\(dqroot user found\(rsn\(dq);
        \f[B]else\f[R]
            printf(\(dqroot user not found (exit %d)\(rsn\(dq, result.exit_code);

        bc_eval_result_free(&result);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqprotocol error: %s\(rsn\(dq, bc_error(client));
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
