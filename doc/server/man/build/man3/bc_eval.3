.SH Multiple commands with persistent state
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int run(bc_client_t *client, const char *cmd)
{
    bc_eval_result_t result;
    int rc = bc_eval(client, cmd, &result);

    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqeval error: %s\(rsn\(dq, bc_error(client));
        \f[B]return\f[R] \-1;
    }

    \f[B]if\f[R] (result.stdout_data[0])
        printf(\(dq%s\(dq, result.stdout_data);
    \f[B]if\f[R] (result.stderr_data[0])
        fprintf(stderr, \(dq%s\(dq, result.stderr_data);

    int exit_code = result.exit_code;
    bc_eval_result_free(&result);
    \f[B]return\f[R] exit_code;
}

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    \f[I]/* State persists across evaluations */\f[R]
    run(client, \(dqcd /tmp\(dq);
    run(client, \(dqexport MY_VAR=hello\(dq);
    run(client, \(dqecho $MY_VAR from $(pwd)\(dq);
    \f[I]/* Output: \(dqhello from /tmp\(dq */\f[R]

    bc_close(client);
    \f[B]return\f[R] 0;
}
