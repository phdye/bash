.SH EXAMPLES
.SH Basic command evaluation
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    int rc = bc_eval(client, \(dqls \-la /tmp\(dq, &result);

    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqeval failed: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    printf(\(dqstdout:\(rsn%s\(dq, result.stdout_data);

    \f[B]if\f[R] (result.stderr_data[0])
        fprintf(stderr, \(dqstderr:\(rsn%s\(dq, result.stderr_data);

    printf(\(dqexit code: %d\(rsn\(dq, result.exit_code);

    bc_eval_result_free(&result);
    bc_close(client);
    \f[B]return\f[R] 0;
}
