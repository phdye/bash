int compile_file(bc_client_t *client, const char *source)
{
    char cmd[1024];
    snprintf(cmd, \f[B]sizeof\f[R](cmd), \(dqgcc \-Wall \-o /tmp/a.out \(aq%s\(aq 2>&1\(dq, source);

    bc_eval_result_t result;
    int rc = bc_eval(client, cmd, &result);

    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqeval failed: %s\(rsn\(dq, bc_error(client));
        \f[B]return\f[R] \-1;
