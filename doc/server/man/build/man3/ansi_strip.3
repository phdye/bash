#include \(dqserver.h\(dq

typedef struct ansi_strip_state {
    int state;      /* STRIP_NORMAL, STRIP_ESC, STRIP_CSI, etc. */
    int active;     /* 1 = stripping enabled */
} ansi_strip_state_t;

size_t ansi_strip(ansi_strip_state_t *st, const char *in, size_t in_len,
                  char *out, size_t out_size);
.EE
.SH DESCRIPTION
Strips ANSI escape sequences from a byte stream.
The filter is \f[B]stateful\f[R]: the \f[CR]ansi_strip_state_t\f[R]
structure persists across calls, allowing correct handling of escape
sequences that are split across \f[CR]read()\f[R] boundaries.
.PP
\f[B]State machine states:\f[R]
.PP
