int channel, flags;
char *payload;
size_t payload_len;

\f[B]while\f[R] (json_frame_read(fd, &channel, &flags, &payload, &payload_len) == 0) {
    \f[B]switch\f[R] (channel) {
    \f[B]case\f[R] CHAN_CONTROL:
        handle_control(payload);
        \f[B]break\f[R];
    \f[B]case\f[R] CHAN_COMMAND:
        handle_command(payload);
        \f[B]break\f[R];
    \f[B]case\f[R] CHAN_STATE:
        handle_state(payload);
        \f[B]break\f[R];
    }
    free(payload);
}
