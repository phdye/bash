.SH EXAMPLES
.SH Finish a function after stepping in
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static int inside_function = 0;

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    printf(\(dqdepth=%d: %s\(rsn\(dq, ev\->depth, ev\->command);

    \f[B]if\f[R] (ev\->depth > 0 && !inside_function) {
        \f[I]/* We just stepped into a function */\f[R]
        inside_function = 1;
        printf(\(dqInside function, inspecting first command...\(rsn\(dq);

        \f[I]/* Run the rest of the function without stopping */\f[R]
        bc_debug_finish(c);
    } \f[B]else\f[R] \f[B]if\f[R] (inside_function && ev\->depth == 0) {
        \f[I]/* Back at top level after finish */\f[R]
        inside_function = 0;
        printf(\(dqReturned from function\(rsn\(dq);
        bc_debug_next(c);
    } \f[B]else\f[R] {
        \f[I]/* Top level: step into functions */\f[R]
        bc_debug_step(c);
    }
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 1, NULL);
    bc_debug_on_break_hit(c, on_break, c);

    bc_eval(c, \(dqsource script.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Depth\-aware stepping
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void depth_stepper(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    \f[B]if\f[R] (ev\->depth > 2) {
        \f[I]/* Too deep \(em finish back to a manageable depth */\f[R]
        printf(\(dqToo deep (depth=%d), finishing...\(rsn\(dq, ev\->depth);
        bc_debug_finish(c);
    } \f[B]else\f[R] {
        printf(\(dq[depth %d] %s\(rsn\(dq, ev\->depth, ev\->command);
        bc_debug_step(c);
    }
}
