.TE
.SH RETURN VALUE
Returns one of:
.IP \(bu 2
\f[CR]PROTOCOL_V1\f[R] (1) \(en Text\-based line protocol.
.IP \(bu 2
\f[CR]PROTOCOL_V2\f[R] (2) \(en Binary length\-prefixed JSON frames.
.IP \(bu 2
\f[CR]PROTOCOL_V2_NDJSON\f[R] (3) \(en Newline\-delimited JSON.
.PP
Returns \f[B]\-1\f[R] on error or if the socket is closed before any
data arrives.
.SH ERRORS
Returns \-1 when:
.IP \(bu 2
\f[CR]recv(2)\f[R] returns 0 (peer closed connection before sending
data).
.IP \(bu 2
\f[CR]recv(2)\f[R] returns \-1 (socket error).
.SH EXAMPLES
.IP
.EX
char first_byte;
int version = protocol_detect_version(client_fd, &first_byte);

\f[B]switch\f[R] (version) {
\f[B]case\f[R] PROTOCOL_V1:
    session_handle(session, config);  \f[I]/* text protocol */\f[R]
    \f[B]break\f[R];
\f[B]case\f[R] PROTOCOL_V2:
    json_set_wire_format(WIRE_BINARY);
    json_session_handle(session, config);
    \f[B]break\f[R];
\f[B]case\f[R] PROTOCOL_V2_NDJSON:
    json_set_wire_format(WIRE_NDJSON);
    json_session_handle(session, config);
    \f[B]break\f[R];
\f[B]default\f[R]:
    fprintf(stderr, \(dqprotocol detection failed\(rsn\(dq);
    \f[B]break\f[R];
}
