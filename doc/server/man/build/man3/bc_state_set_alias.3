.SH EXAMPLES
.SH Define a simple alias
.IP
.EX
int rc = bc_state_set_alias(client, \(dqll\(dq, \(dqls \-la\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_alias failed: %d\(rsn\(dq, rc);
.EE
.SH Define an alias with special characters
.IP
.EX
\f[I]/* Alias expansion values can contain pipes, quotes, etc. */\f[R]
int rc = bc_state_set_alias(client, \(dqgrep\(dq,
                            \(dqgrep \-\-color=auto\(dq);
\f[B]if\f[R] (rc != BC_OK)
    fprintf(stderr, \(dqset_alias failed: %d\(rsn\(dq, rc);
.EE
.SH Replace an existing alias
.IP
.EX
\f[I]/* First definition */\f[R]
bc_state_set_alias(client, \(dqll\(dq, \(dqls \-l\(dq);

\f[I]/* Replace with a different value */\f[R]
int rc = bc_state_set_alias(client, \(dqll\(dq, \(dqls \-la \-\-color=auto\(dq);
assert(rc == BC_OK);

\f[I]/* Verify the new value */\f[R]
char *val = NULL;
rc = bc_state_get_alias(client, \(dqll\(dq, &val);
\f[B]if\f[R] (rc == BC_OK) {
    printf(\(dqll \-> %s\(rsn\(dq, val);  \f[I]/* \(dqls \-la \-\-color=auto\(dq */\f[R]
    bc_free(val);
}
.EE
.SH Define a trailing\-space alias for chaining
.IP
.EX
\f[I]/* A trailing space causes the next word to also be checked\f[R]
\f[I]   for alias expansion */\f[R]
int rc = bc_state_set_alias(client, \(dqsudo\(dq, \(dqsudo \(dq);
assert(rc == BC_OK);
