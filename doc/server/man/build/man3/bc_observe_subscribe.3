.SH ERRORS
.IP \(bu 2
If the client has not yet authenticated, the server rejects the request
and the function returns \f[CR]BC_ERR_AUTH\f[R].
.IP \(bu 2
If the connection is broken during the exchange, returns
\f[CR]BC_ERR_TRANSPORT\f[R].
.SH EXAMPLES
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void on_pre(const bc_pre_command_event_t *ev, void *ud)
{
    printf(\(dq[pre] seq=%d cmd=%s cwd=%s line=%d\(rsn\(dq,
           ev\->seq, ev\->command, ev\->cwd, ev\->line_number);
}

static void on_post(const bc_post_command_event_t *ev, void *ud)
{
    printf(\(dq[post] seq=%d cmd=%s exit=%d duration=%dms\(rsn\(dq,
           ev\->seq, ev\->command, ev\->exit_status, ev\->duration_ms);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;

    \f[B]if\f[R] (bc_auth(c, \(dqmytoken\(dq) != BC_OK) {
        bc_disconnect(c);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Register callbacks before subscribing */\f[R]
    bc_observe_on_pre_command(c, on_pre, NULL);
    bc_observe_on_post_command(c, on_post, NULL);

    \f[I]/* Subscribe to command\-level events */\f[R]
    int rc = bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);
    \f[B]if\f[R] (rc != BC_OK) {
        fprintf(stderr, \(dqsubscribe failed: %d\(rsn\(dq, rc);
        bc_disconnect(c);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Execute a command \(em events will be generated */\f[R]
    bc_eval(c, \(dqecho hello\(dq, NULL, NULL, NULL);

    \f[I]/* Poll to receive and dispatch events */\f[R]
    bc_poll(c, 1000);

    bc_observe_unsubscribe(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
