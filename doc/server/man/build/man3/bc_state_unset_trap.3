\f[I]/* SIGINT is now ignored (not default) */\f[R]

\f[I]/* Unsetting RESETS to default behavior */\f[R]
bc_state_unset_trap(client, \(dqSIGINT\(dq);
\f[I]/* SIGINT now terminates the process (default) */\f[R]
