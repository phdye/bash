.SH EXAMPLES
.SH Basic debugger with break\-hit handler
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

\f[B]typedef\f[R] \f[B]struct\f[R] {
    bc_client_t *client;
    int           hit_count;
    int           max_hits;
} debugger_ctx_t;

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    debugger_ctx_t *ctx = (debugger_ctx_t *)ud;
    ctx\->hit_count++;

    printf(\(dqBreak #%d at line %d (depth %d): %s\(rsn\(dq,
           ctx\->hit_count, ev\->line, ev\->depth, ev\->command);

    \f[I]/* Inspect the AST */\f[R]
    char *ast = NULL;
    \f[B]if\f[R] (bc_debug_inspect_ast(ctx\->client, &ast) == BC_OK) {
        printf(\(dq  AST: %.200s%s\(rsn\(dq, ast,
               strlen(ast) > 200 ? \(dq...\(dq : \(dq\(dq);
        free(ast);
    }

    \f[B]if\f[R] (ctx\->hit_count >= ctx\->max_hits) {
        printf(\(dqMax hits reached, continuing...\(rsn\(dq);
        bc_debug_continue(ctx\->client);
    } \f[B]else\f[R] {
        bc_debug_step(ctx\->client);
    }
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    debugger_ctx_t ctx = {
        .client    = c,
        .hit_count = 0,
        .max_hits  = 50
    };

    \f[I]/* Register callback before enabling debugger */\f[R]
    bc_debug_on_break_hit(c, on_break, &ctx);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 1, NULL);

    bc_eval(c, \(dqsource target.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    printf(\(dqTotal break hits: %d\(rsn\(dq, ctx.hit_count);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Combining observe and debug callbacks
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void on_pre(const bc_pre_command_event_t *ev, void *ud)
{
    \f[I]/* Observe sees all commands, even when debugger is active */\f[R]
    printf(\(dq[observe] %s\(rsn\(dq, ev\->command);
}

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    printf(\(dq[debug] BREAK line %d: %s\(rsn\(dq, ev\->line, ev\->command);
    bc_debug_continue(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    \f[I]/* Register both callback types */\f[R]
    bc_observe_on_pre_command(c, on_pre, NULL);
    bc_debug_on_break_hit(c, on_break, c);

    \f[I]/* Enable both observe and debug */\f[R]
    bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);
    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho\(dq, \-1, NULL);

    bc_eval(c, \(dqecho test; ls; echo done\(dq, NULL, NULL, NULL);

    \f[I]/* Single poll loop handles both event types */\f[R]
    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_observe_unsubscribe(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
