.SH Periodic keepalive loop
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]
#include \f[B]<unistd.h>\f[R]

int keepalive_loop(bc_client_t *client, int interval_sec, int max_failures)
{
    int consecutive_failures = 0;

    \f[B]while\f[R] (consecutive_failures < max_failures) {
        sleep(interval_sec);

        \f[B]if\f[R] (bc_ping(client) == BC_OK) {
            consecutive_failures = 0;
        } \f[B]else\f[R] {
            consecutive_failures++;
            fprintf(stderr, \(dqping failed (%d/%d): %s\(rsn\(dq,
                    consecutive_failures, max_failures,
                    bc_error(client));
        }
    }

    \f[B]return\f[R] \-1;  \f[I]/* max failures reached */\f[R]
}

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Ping every 30 seconds, give up after 3 consecutive failures */\f[R]
    keepalive_loop(client, 30, 3);

    fprintf(stderr, \(dqserver unreachable, exiting\(rsn\(dq);
    bc_close(client);
    \f[B]return\f[R] 1;
}
.EE
.SH Connection health check before command
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int safe_eval(bc_client_t *client, const char *cmd,
              bc_eval_result_t *result)
{
    \f[I]/* Quick health check before sending a potentially expensive command */\f[R]
    \f[B]if\f[R] (bc_ping(client) != BC_OK) {
        fprintf(stderr, \(dqserver not responsive: %s\(rsn\(dq,
                bc_error(client));
        \f[B]return\f[R] BC_ERR_TRANSPORT;
    }

    \f[B]return\f[R] bc_eval(client, cmd, result);
}

int main(void)
{
    bc_client_t *client = bc_connect(NULL);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (safe_eval(client, \(dqmake \-j12 all\(dq, &result) == BC_OK) {
        printf(\(dq%s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
