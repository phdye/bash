.SH RETURN VALUE
Returns \f[B]0\f[R] on clean disconnect or connection close.
.PP
Returns \f[B]\-1\f[R] on error (currently not used; errors break the
read loop and return 0).
.SH ERRORS
The function handles errors internally by breaking the frame read loop.
Frame read errors (connection closed, malformed frames) cause the
session to end gracefully.
.SH EXAMPLES
.IP
.EX
client_session_t session;
session_init(&session, client_fd);

char first_byte;
int version = protocol_detect_version(client_fd, &first_byte);

\f[B]if\f[R] (version == PROTOCOL_V2 || version == PROTOCOL_V2_NDJSON) {
    \f[B]if\f[R] (version == PROTOCOL_V2_NDJSON)
        json_set_wire_format(WIRE_NDJSON);
    json_session_handle(&session, &server_config);
} \f[B]else\f[R] {
    session_handle(&session, &server_config);
}

session_cleanup(&session);
