.SH EXAMPLES
.SH Connect to a Named Pipe server
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(void)
{
    const char *pipe = \(dq//./pipe/bash\-server\(dq;
    bc_client_t *client;

    client = bc_connect_named_pipe(pipe);
    \f[B]if\f[R] (!client) {
        perror(\(dqbc_connect_named_pipe\(dq);
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(client, \(dqcygpath \-w /home\(dq, &result) == BC_OK) {
        printf(\(dqWindows path: %s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
.EE
.SH Connect with custom pipe name
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

int main(int argc, char *argv[])
{
    const char *pipe_name;
    bc_client_t *client;

    \f[B]if\f[R] (argc > 1)
        pipe_name = argv[1];
    \f[B]else\f[R]
        pipe_name = \(dq//./pipe/bash\-server\-myapp\(dq;

    client = bc_connect_named_pipe(pipe_name);
    \f[B]if\f[R] (!client) {
        fprintf(stderr, \(dqbc_connect_named_pipe(%s): %s\(rsn\(dq,
                pipe_name, strerror(errno));
        \f[B]return\f[R] 1;
    }

    \f[B]if\f[R] (bc_auth(client, getenv(\(dqBASH_SERVER_TOKEN\(dq)) != BC_OK) {
        fprintf(stderr, \(dqauth failed: %s\(rsn\(dq, bc_error(client));
        bc_close(client);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Run multiple commands */\f[R]
    const char *commands[] = {\(dqpwd\(dq, \(dqecho $SHELL\(dq, \(dqid\(dq, NULL};
    \f[B]for\f[R] (int i = 0; commands[i]; i++) {
        bc_eval_result_t result;
        \f[B]if\f[R] (bc_eval(client, commands[i], &result) == BC_OK) {
            printf(\(dq$ %s\(rsn%s\(dq, commands[i], result.stdout_data);
            bc_eval_result_free(&result);
        } \f[B]else\f[R] {
            fprintf(stderr, \(dqeval failed: %s\(rsn\(dq, bc_error(client));
        }
    }

    bc_close(client);
    \f[B]return\f[R] 0;
}
