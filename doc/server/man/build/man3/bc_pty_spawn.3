.SH ERRORS
On error, any partially\-constructed server\-side PTY is cleaned up
automatically.
The \f[B]info\f[R] structure is zeroed on failure.
.PP
If the server cannot allocate a PTY (e.g., out of file descriptors), it
responds with an error frame and the function returns
\f[CR]BC_ERR_SERVER\f[R].
.SH EXAMPLES
.SH Basic PTY spawn
.IP
.EX
bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, token);
\f[B]if\f[R] (!c) {
    fprintf(stderr, \(dqconnect failed\(rsn\(dq);
    \f[B]return\f[R] 1;
}

bc_pty_info_t info;
int rc = bc_pty_spawn(c, 24, 80, NULL, 0, &info);
\f[B]if\f[R] (rc != BC_OK) {
    fprintf(stderr, \(dqpty spawn failed: %d\(rsn\(dq, rc);
    bc_disconnect(c);
    \f[B]return\f[R] 1;
}

printf(\(dqPTY spawned: %dx%d, pid=%d\(rsn\(dq, info.cols, info.rows, info.pid);
.EE
.SH Spawn with ANSI stripping for programmatic use
.IP
.EX
bc_pty_info_t info;
int rc = bc_pty_spawn(c, 24, 80, \(dq/bin/sh\(dq, 1, &info);
\f[B]if\f[R] (rc == BC_OK && info.strip_ansi) {
    printf(\(dqANSI stripping active \(em output is clean text\(rsn\(dq);
}
.EE
