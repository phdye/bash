.IP
.EX
bc_pty_info_t info;
int rc = bc_pty_spawn(c, 40, 120, \(dq/usr/bin/zsh\(dq, 0, &info);
\f[B]if\f[R] (rc != BC_OK) {
    fprintf(stderr, \(dqspawn failed: %d\(rsn\(dq, rc);
}
