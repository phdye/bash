char *decoded = bc_b64_decode(\(dqSGVsbG8sIFdvcmxkIQ==\(dq, &len);
\f[B]if\f[R] (decoded) {
    printf(\(dqDecoded (%zu bytes): %s\(rsn\(dq, len, decoded);
    \f[I]/* Output: Decoded (13 bytes): Hello, World! */\f[R]
    bc_free(decoded);
