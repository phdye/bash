.SH Round\-trip with bc_b64_encode
.IP
.EX
const char original[] = {0x00, 0x01, 0x02, 0xFE, 0xFF};
size_t orig_len = \f[B]sizeof\f[R](original);

char *encoded = bc_b64_encode(original, orig_len);
