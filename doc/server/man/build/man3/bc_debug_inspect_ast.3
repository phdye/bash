.SH EXAMPLES
.SH Inspect AST at a breakpoint
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]

static void inspect_handler(const bc_break_hit_event_t *ev,
                            void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    char *ast = NULL;

    printf(\(dqStopped at line %d: %s\(rsn\(dq, ev\->line, ev\->command);

    int rc = bc_debug_inspect_ast(c, &ast);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqAST:\(rsn%s\(rsn\(dq, ast);
        free(ast);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqinspect_ast failed: %d\(rsn\(dq, rc);
    }

    bc_debug_continue(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho\(dq, \-1, NULL);
    bc_debug_on_break_hit(c, inspect_handler, c);

    bc_eval(c, \(dqecho hello | grep h\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
