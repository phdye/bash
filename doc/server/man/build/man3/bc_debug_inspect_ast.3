.SH Conditional inspection
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]
#include \f[B]<string.h>\f[R]

static void check_redirects(const bc_break_hit_event_t *ev,
                            void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    char *ast = NULL;

    \f[B]if\f[R] (bc_debug_inspect_ast(c, &ast) == BC_OK) {
        \f[I]/* Check if command has output redirections */\f[R]
        \f[B]if\f[R] (strstr(ast, \(dq\(rs\(dqredirects\(rs\(dq:[{\(dq)) {
            printf(\(dqWARNING: command has redirections: %s\(rsn\(dq,
                   ev\->command);
        }
        free(ast);
    }

    bc_debug_continue(c);
}
