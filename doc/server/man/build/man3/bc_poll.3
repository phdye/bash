#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

void drain_events(bc_client_t *c)
{
    int n;
    \f[B]while\f[R] ((n = bc_poll(c, 0)) > 0)
        printf(\(dqProcessed %d messages\(rsn\(dq, n);

    \f[B]if\f[R] (n < 0)
        fprintf(stderr, \(dqPoll error: %d\(rsn\(dq, n);
