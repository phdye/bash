.EE
.SH Event loop with timeout
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static volatile int running = 1;

static void on_pre(const bc_pre_command_event_t *ev, void *ud)
{
    printf(\(dq>>> %s\(rsn\(dq, ev\->command);
}

static void on_post(const bc_post_command_event_t *ev, void *ud)
{
    printf(\(dq<<< %s [exit=%d, %dms]\(rsn\(dq,
           ev\->command, ev\->exit_status, ev\->duration_ms);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_observe_on_pre_command(c, on_pre, NULL);
    bc_observe_on_post_command(c, on_post, NULL);
    bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);

    \f[I]/* Main event loop */\f[R]
    \f[B]while\f[R] (running) {
        int n = bc_poll(c, 1000);
        \f[B]if\f[R] (n < 0) {
            fprintf(stderr, \(dqConnection lost: %d\(rsn\(dq, n);
            \f[B]break\f[R];
        }
        \f[I]/* n == 0 means timeout, loop again */\f[R]
    }

    bc_observe_unsubscribe(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Combined observe and debug polling
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    printf(\(dqBREAK at line %d: %s (depth=%d)\(rsn\(dq,
           ev\->line, ev\->command, ev\->depth);
    \f[I]/* Continue execution after inspecting state */\f[R]
    bc_client_t *c = (bc_client_t *)ud;
    bc_debug_continue(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    \f[I]/* Set up both observe and debug callbacks */\f[R]
    bc_observe_on_pre_command(c, my_pre_cb, NULL);
    bc_debug_on_break_hit(c, on_break, c);

    bc_observe_subscribe(c, BC_OBSERVE_LEVEL_COMMAND);
    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 5, NULL);

    bc_eval(c, \(dqsource myscript.sh\(dq, NULL, NULL, NULL);

    \f[I]/* Single poll loop handles all event types */\f[R]
    \f[B]while\f[R] (bc_poll(c, 2000) >= 0)
        ;

    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
