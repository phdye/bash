.SH EXAMPLES
.SH Single\-step through a script
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void step_handler(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    int *steps = (int *)((char *)ud + \f[B]sizeof\f[R](bc_client_t *));

    printf(\(dq[step %d] line=%d depth=%d: %s\(rsn\(dq,
           *steps, ev\->line, ev\->depth, ev\->command);
    (*steps)++;

    \f[B]if\f[R] (*steps >= 20) {
        \f[I]/* Stop stepping after 20 commands */\f[R]
        bc_debug_continue(c);
    } \f[B]else\f[R] {
        bc_debug_step(c);
    }
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);

    \f[I]/* Break at the start of the script */\f[R]
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 1, NULL);

    int steps = 0;
    bc_debug_on_break_hit(c, step_handler, c);

    bc_eval(c, \(dqsource myscript.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    printf(\(dqStepped through %d commands\(rsn\(dq, steps);

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Step into a function
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

\f[I]/*\f[R]
\f[I] * Given this script:\f[R]
\f[I] *   line 1: greet() { echo \(dqhello $1\(dq; }\f[R]
\f[I] *   line 2: greet world\f[R]
\f[I] *\f[R]
\f[I] * bc_debug_step() at line 2 stops at \(dqecho hello world\(dq\f[R]
\f[I] * bc_debug_next() at line 2 would skip over the function\f[R]
\f[I] */\f[R]
static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    printf(\(dqdepth=%d: %s\(rsn\(dq, ev\->depth, ev\->command);

    \f[I]/* Step into the function call */\f[R]
    bc_debug_step(c);
}
