.SH EXAMPLES
.SH Skip destructive commands
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<string.h>\f[R]

static void safe_handler(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    \f[I]/* Skip any rm commands */\f[R]
    \f[B]if\f[R] (strstr(ev\->command, \(dqrm \(dq)) {
        printf(\(dqSKIPPING destructive command: %s\(rsn\(dq, ev\->command);
        bc_debug_skip(c);
        \f[B]return\f[R];
    }

    printf(\(dqExecuting: %s\(rsn\(dq, ev\->command);
    bc_debug_step(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);

    \f[I]/* Break on every command to inspect it */\f[R]
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 1, NULL);
    bc_debug_on_break_hit(c, safe_handler, c);

    \f[I]/* Run a script that might delete files */\f[R]
    bc_eval(c, \(dqsource cleanup.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
.EE
.SH Interactive skip decision
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void interactive_handler(const bc_break_hit_event_t *ev,
                                void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    printf(\(dqline %d: %s\(rsn\(dq, ev\->line, ev\->command);
    printf(\(dq  [s]tep  [n]ext  [c]ontinue  [k]ip  [f]inish ? \(dq);

    int ch = getchar();
    \f[B]while\f[R] (getchar() != \(aq\(rsn\(aq)  \f[I]/* drain input */\f[R]
        ;

    \f[B]switch\f[R] (ch) {
    \f[B]case\f[R] \(aqs\(aq: bc_debug_step(c);     \f[B]break\f[R];
    \f[B]case\f[R] \(aqn\(aq: bc_debug_next(c);     \f[B]break\f[R];
    \f[B]case\f[R] \(aqc\(aq: bc_debug_continue(c); \f[B]break\f[R];
    \f[B]case\f[R] \(aqk\(aq: bc_debug_skip(c);     \f[B]break\f[R];
    \f[B]case\f[R] \(aqf\(aq: bc_debug_finish(c);   \f[B]break\f[R];
    \f[B]default\f[R]:  bc_debug_step(c);     \f[B]break\f[R];
    }
}
