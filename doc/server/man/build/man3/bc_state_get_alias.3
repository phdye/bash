If the named alias does not exist, returns \f[CR]BC_ERR_SERVER\f[R].
.IP \(bu 2
If aliases are disabled in the session (e.g., via
\f[CR]shopt \-u expand_aliases\f[R]), the alias table may still be
queried; this function queries the table regardless of whether alias
expansion is active.
.SH EXAMPLES
.SH Retrieve an alias
.IP
.EX
#include \f[B]\(dqbashclient.h\(dq\f[R]
#include \f[B]<stdio.h>\f[R]

int main(void)
{
    bc_client_t *client;
    char *val = NULL;
    int rc;

    client = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!client)
        \f[B]return\f[R] 1;

    \f[I]/* Define an alias via eval */\f[R]
    bc_eval(client, \(dqalias ll=\(aqls \-la \-\-color=auto\(aq\(dq,
            NULL, NULL, NULL);

    \f[I]/* Retrieve it */\f[R]
    rc = bc_state_get_alias(client, \(dqll\(dq, &val);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqll \-> %s\(rsn\(dq, val);
        bc_free(val);
    } \f[B]else\f[R] {
        fprintf(stderr, \(dqget_alias failed: %d\(rsn\(dq, rc);
    }

    bc_disconnect(client);
    \f[B]return\f[R] 0;
}
.EE
.SH Check if an alias exists
.IP
.EX
char *val = NULL;
int rc = bc_state_get_alias(client, \(dqgrep\(dq, &val);
\f[B]if\f[R] (rc == BC_ERR_SERVER) {
    printf(\(dqalias \(aqgrep\(aq is not defined\(rsn\(dq);
} \f[B]else\f[R] \f[B]if\f[R] (rc == BC_OK) {
    printf(\(dqalias grep=\(aq%s\(aq\(rsn\(dq, val);
    bc_free(val);
}
.EE
.SH Retrieve multiple aliases
.IP
.EX
const char *names[] = { \(dqls\(dq, \(dqll\(dq, \(dqla\(dq, \(dqgrep\(dq, NULL };
\f[B]for\f[R] (int i = 0; names[i]; i++) {
    char *val = NULL;
    int rc = bc_state_get_alias(client, names[i], &val);
    \f[B]if\f[R] (rc == BC_OK) {
        printf(\(dqalias %s=\(aq%s\(aq\(rsn\(dq, names[i], val);
        bc_free(val);
    }
}
