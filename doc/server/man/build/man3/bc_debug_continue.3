#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    printf(\(dqHit breakpoint at line %d: %s\(rsn\(dq, ev\->line, ev\->command);

    \f[I]/* Inspect state if needed */\f[R]
    char *ast = NULL;
    \f[B]if\f[R] (bc_debug_inspect_ast(c, &ast) == BC_OK) {
        printf(\(dqAST: %s\(rsn\(dq, ast);
        free(ast);
    }

    \f[I]/* Resume execution */\f[R]
    bc_debug_continue(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 5, NULL);
    bc_debug_on_break_hit(c, on_break, c);

    bc_eval(c, \(dqsource test.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
