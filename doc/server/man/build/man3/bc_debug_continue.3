.SH Continue vs step comparison
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]

static int break_count = 0;

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;
    break_count++;

    printf(\(dqBreak #%d at line %d (depth %d): %s\(rsn\(dq,
           break_count, ev\->line, ev\->depth, ev\->command);

    \f[B]if\f[R] (break_count < 3) {
        \f[I]/* Step through first few commands */\f[R]
        bc_debug_step(c);
    } \f[B]else\f[R] {
        \f[I]/* Then continue to next breakpoint */\f[R]
        bc_debug_continue(c);
    }
}
