.SH Mixed stepping strategy
.IP
.EX
#include \f[B]<bashclient.h>\f[R]
#include \f[B]<stdio.h>\f[R]
#include \f[B]<string.h>\f[R]

static void smart_step(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    \f[I]/* Step into functions of interest, step over others */\f[R]
    \f[B]if\f[R] (strstr(ev\->command, \(dqmy_function\(dq)) {
        printf(\(dqStepping INTO: %s\(rsn\(dq, ev\->command);
        bc_debug_step(c);
    } \f[B]else\f[R] {
        printf(\(dqStepping OVER: %s\(rsn\(dq, ev\->command);
        bc_debug_next(c);
    }
}
