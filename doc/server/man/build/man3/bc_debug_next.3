#include \f[B]<stdio.h>\f[R]

\f[I]/*\f[R]
\f[I] * Script:\f[R]
\f[I] *   line 1: setup() { echo \(dqsetting up\(dq; configure; }\f[R]
\f[I] *   line 2: setup\f[R]
\f[I] *   line 3: echo \(dqdone\(dq\f[R]
\f[I] *\f[R]
\f[I] * With bc_debug_next() at line 2:\f[R]
\f[I] *   \- setup() executes fully without stopping\f[R]
\f[I] *   \- Debugger stops at line 3 (\(dqecho done\(dq)\f[R]
\f[I] *\f[R]
\f[I] * With bc_debug_step() at line 2:\f[R]
\f[I] *   \- Debugger stops at \(dqecho setting up\(dq inside setup()\f[R]
\f[I] */\f[R]

static void on_break(const bc_break_hit_event_t *ev, void *ud)
{
    bc_client_t *c = (bc_client_t *)ud;

    printf(\(dqline=%d depth=%d: %s\(rsn\(dq,
           ev\->line, ev\->depth, ev\->command);

    \f[I]/* Step over \(em skip into function internals */\f[R]
    bc_debug_next(c);
}

int main(void)
{
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq, NULL);
    \f[B]if\f[R] (!c) \f[B]return\f[R] 1;
    bc_auth(c, \(dqmytoken\(dq);

    bc_debug_enable(c);
    bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 1, NULL);
    bc_debug_on_break_hit(c, on_break, c);

    bc_eval(c, \(dqsource myscript.sh\(dq, NULL, NULL, NULL);

    \f[B]while\f[R] (bc_poll(c, 5000) >= 0)
        ;

    bc_debug_disable(c);
    bc_disconnect(c);
    \f[B]return\f[R] 0;
}
