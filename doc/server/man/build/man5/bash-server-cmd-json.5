  \(dqflags\(dq: \f[B]N\f[R],
  \(dqline\(dq: \f[B]N\f[R],
  \(dqredirects\(dq: [\f[B]...\f[R]],
  \(dqTYPE_KEY\(dq: { \f[B]...\f[R] }
}
