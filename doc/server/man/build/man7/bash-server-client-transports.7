.PP
Typical client token reading:
.IP
.EX
\f[B]import\f[R] os

socket_path = \(dq/tmp/bash\-server\-1000/sock\(dq
token_path = os.path.join(os.path.dirname(socket_path), \(dqtoken\(dq)
\f[B]with\f[R] open(token_path) \f[B]as\f[R] f:
    token = f.read().strip()

\f[B]async\f[R] \f[B]with\f[R] BashClient.connect(socket_path) \f[B]as\f[R] client:
    \f[B]await\f[R] client.auth(token)
.EE
