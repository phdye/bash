.SH CHAN_OBSERVE (3) \(en Command observation events
CHAN_OBSERVE delivers pre\-command and post\-command events when
commands are executed on the server.
This channel requires explicit subscription.
.PP
\f[B]Subscribe/unsubscribe\f[R] are request/response operations:
.PP
Python:
.IP
.EX
\f[B]await\f[R] client.observe.subscribe(level=1)
\f[B]await\f[R] client.observe.unsubscribe()
.EE
.PP
TypeScript:
.IP
.EX
\f[B]await\f[R] client.observe.subscribe(1);
\f[B]await\f[R] client.observe.unsubscribe();
.EE
.PP
C:
.IP
.EX
bc_observe_subscribe(c, 1);
bc_observe_unsubscribe(c);
.EE
.PP
Java:
.IP
.EX
client.observe.subscribe(1);
client.observe.unsubscribe();
.EE
.PP
\f[B]Events\f[R] are server\-push messages dispatched to callbacks:
.PP
\f[CR]pre_command\f[R] fires before a command executes and includes: \-
\f[CR]seq\f[R] \(en Sequence number for ordering \- \f[CR]timestamp\f[R]
\(en Unix timestamp (milliseconds) \- \f[CR]command\f[R] \(en The
command string \- \f[CR]cwd\f[R] \(en Current working directory \-
\f[CR]line_number\f[R] \(en Source line number \- \f[CR]is_subshell\f[R]
\(en True if executing in a subshell \- \f[CR]is_async\f[R] \(en True if
background execution
.PP
\f[CR]post_command\f[R] fires after a command completes and includes: \-
\f[CR]seq\f[R] \(en Sequence number \- \f[CR]timestamp\f[R] \(en Unix
timestamp (milliseconds) \- \f[CR]command\f[R] \(en The command string
\- \f[CR]exit_status\f[R] \(en Exit code \- \f[CR]signal_number\f[R]
\(en Signal that killed the command (0 if none) \-
\f[CR]duration_ms\f[R] \(en Execution time in milliseconds
.PP
\f[B]Callback registration per language:\f[R]
.PP
Python:
.IP
.EX
\f[B]def\f[R] on_pre(event: PreCommandEvent):
    print(f\(dqrunning: {event.command}\(dq)

\f[B]async\f[R] \f[B]def\f[R] on_post(event: PostCommandEvent):
    print(f\(dqdone: {event.command} ({event.duration_ms}ms)\(dq)

client.observe.on(\(dqpre_command\(dq, on_pre)
client.observe.on(\(dqpost_command\(dq, on_post)
client.observe.off(\(dqpre_command\(dq, on_pre)
.EE
.PP
TypeScript:
.IP
.EX
client.observe.on(\(dqpre_command\(dq, (event: PreCommandEvent) \f[B]=>\f[R] {
    console.log(\(garunning: ${event.command}\(ga);
});
client.observe.on(\(dqpost_command\(dq, (event: PostCommandEvent) \f[B]=>\f[R] {
    console.log(\(gadone: ${event.command}\(ga);
});
client.observe.off(\(dqpre_command\(dq);
.EE
.PP
C:
.IP
.EX
void on_pre(const bc_pre_command_event_t *e, void *ud) {
    printf(\(dqrunning: %s\(rsn\(dq, e\->command);
}
void on_post(const bc_post_command_event_t *e, void *ud) {
    printf(\(dqdone: %s (%dms)\(rsn\(dq, e\->command, e\->duration_ms);
}
bc_observe_on_pre_command(c, on_pre, NULL);
bc_observe_on_post_command(c, on_post, NULL);
\f[I]/* Must call bc_poll() to dispatch events */\f[R]
bc_poll(c, 1000);
.EE
.PP
Java:
.IP
.EX
client.observe.onPreCommand(event \->
    System.out.println(\(dqrunning: \(dq + event.command));
client.observe.onPostCommand(event \->
    System.out.println(\(dqdone: \(dq + event.command));
.EE
.SH CHAN_DEBUG (4) \(en Interactive debugger
CHAN_DEBUG provides breakpoint management, execution control, and AST
inspection.
It combines request/response operations (enable, add breakpoint, step,
inspect) with server\-push events (break_hit).
.PP
\f[B]Enable/disable:\f[R]
.PP
Python:
.IP
.EX
\f[B]await\f[R] client.debug.enable()
\f[B]await\f[R] client.debug.disable()
status = \f[B]await\f[R] client.debug.status()
.EE
.PP
TypeScript:
.IP
.EX
\f[B]await\f[R] client.debug.enable();
\f[B]await\f[R] client.debug.disable();
\f[B]const\f[R] status = \f[B]await\f[R] client.debug.status();
.EE
.PP
C:
.IP
.EX
bc_debug_enable(c);
bc_debug_disable(c);
bc_debug_status_t status;
bc_debug_status(c, &status);
bc_debug_status_free(&status);
.EE
.PP
Java:
.IP
.EX
client.debug.enable();
client.debug.disable();
DebugStatus status = client.debug.status();
.EE
.PP
\f[B]Breakpoint management:\f[R]
.PP
Three breakpoint kinds are supported: \f[CR]\(dqcommand\(dq\f[R]
(pattern matching on command strings), \f[CR]\(dqline\(dq\f[R] (source
line number), and \f[CR]\(dqfunction\(dq\f[R] (function name pattern).
.PP
Python:
.IP
.EX
bp_id = \f[B]await\f[R] client.debug.add_breakpoint(\(dqcommand\(dq, pattern=\(dqecho*\(dq)
bp_id2 = \f[B]await\f[R] client.debug.add_breakpoint(\(dqline\(dq, line=10)
bps = \f[B]await\f[R] client.debug.list_breakpoints()
\f[B]await\f[R] client.debug.remove_breakpoint(bp_id)
\f[B]await\f[R] client.debug.enable_breakpoint(bp_id2)
\f[B]await\f[R] client.debug.disable_breakpoint(bp_id2)
.EE
.PP
TypeScript:
.IP
.EX
\f[B]const\f[R] bpId = \f[B]await\f[R] client.debug.addBreakpoint(\(dqcommand\(dq, { pattern: \(dqecho*\(dq });
\f[B]const\f[R] bpId2 = \f[B]await\f[R] client.debug.addBreakpoint(\(dqline\(dq, { line: 10 });
\f[B]const\f[R] bps = \f[B]await\f[R] client.debug.listBreakpoints();
\f[B]await\f[R] client.debug.removeBreakpoint(bpId);
.EE
.PP
C:
.IP
.EX
int bp_id = bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho*\(dq, \-1, NULL);
int bp_id2 = bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 10, NULL);
bc_breakpoint_t *bps; int count;
bc_debug_list_breakpoints(c, &bps, &count);
bc_breakpoint_list_free(bps, count);
bc_debug_remove_breakpoint(c, bp_id);
.EE
.PP
Java:
.IP
.EX
int bpId = client.debug.addBreakpoint(\(dqcommand\(dq, \(dqecho*\(dq, \-1, \f[B]null\f[R]);
int bpId2 = client.debug.addBreakpoint(\(dqline\(dq, \f[B]null\f[R], 10, \f[B]null\f[R]);
List<Breakpoint> bps = client.debug.listBreakpoints();
client.debug.removeBreakpoint(bpId);
.EE
.PP
\f[B]Execution control:\f[R]
.PP
Five execution control commands resume execution after a break_hit:
.PP
.TS
tab(@);
l l.
T{
Command
T}@T{
Behavior
T}
_
T{
\f[CR]continue\f[R]
T}@T{
Run until next breakpoint
T}
T{
\f[CR]step\f[R]
T}@T{
Execute one command, step into functions
T}
T{
\f[CR]next\f[R]
T}@T{
Execute one command, step over functions
T}
T{
\f[CR]finish\f[R]
T}@T{
Run until current function returns
T}
T{
\f[CR]skip\f[R]
T}@T{
Skip the current command without executing
T}
.TE
.PP
Python:
.IP
.EX
\f[B]await\f[R] client.debug.continue_()  \f[I]# trailing underscore\f[R]
\f[B]await\f[R] client.debug.step()
\f[B]await\f[R] client.debug.next()
\f[B]await\f[R] client.debug.finish()
\f[B]await\f[R] client.debug.skip()
.EE
.PP
TypeScript:
.IP
.EX
\f[B]await\f[R] client.debug.continue();
\f[B]await\f[R] client.debug.step();
\f[B]await\f[R] client.debug.next();
\f[B]await\f[R] client.debug.finish();
\f[B]await\f[R] client.debug.skip();
.EE
.PP
C:
.IP
.EX
bc_debug_continue(c);
bc_debug_step(c);
bc_debug_next(c);
bc_debug_finish(c);
bc_debug_skip(c);
.EE
.PP
Java:
.IP
.EX
client.debug.doContinue();  \f[I]// avoid Java keyword\f[R]
client.debug.step();
client.debug.next();
client.debug.finish();
client.debug.skip();
.EE
.PP
Note language keyword conflicts: Python uses \f[CR]continue_()\f[R]
(trailing underscore), Java uses \f[CR]doContinue()\f[R].
TypeScript and C have no conflict.
.PP
\f[B]AST inspection:\f[R]
.PP
Inspect the pending COMMAND tree as JSON when stopped at a breakpoint:
.PP
Python:
.IP
.EX
ast = \f[B]await\f[R] client.debug.inspect_ast()
.EE
.PP
TypeScript:
.IP
.EX
\f[B]const\f[R] ast = \f[B]await\f[R] client.debug.inspectAst();
.EE
.PP
C:
.IP
.EX
char *json_ast;
bc_debug_inspect_ast(c, &json_ast);
bc_free(json_ast);
.EE
.PP
Java:
.IP
.EX
String ast = client.debug.inspectAst();
.EE
.PP
\f[B]break_hit callback:\f[R]
.PP
The \f[CR]break_hit\f[R] push event fires when a breakpoint or step
boundary is reached.
It includes \f[CR]line\f[R], \f[CR]command\f[R], and \f[CR]depth\f[R]
fields.
.PP
Python:
.IP
.EX
\f[B]async\f[R] \f[B]def\f[R] on_break(event: BreakHitEvent):
    print(f\(dqbreak: line {event.line}, {event.command}\(dq)
    \f[B]await\f[R] client.debug.step()

client.debug.on(\(dqbreak_hit\(dq, on_break)
.EE
.PP
TypeScript:
.IP
.EX
client.debug.on(\(dqbreak_hit\(dq, (event: BreakHitEvent) \f[B]=>\f[R] {
    console.log(\(gabreak: line ${event.line}, ${event.command}\(ga);
    client.debug.step();
});
.EE
.PP
C:
.IP
.EX
void on_break(const bc_break_hit_event_t *e, void *ud) {
    printf(\(dqbreak: line %d, %s\(rsn\(dq, e\->line, e\->command);
    bc_debug_step((bc_client_t *)ud);
}
bc_debug_on_break_hit(c, on_break, c);
.EE
.PP
Java:
.IP
.EX
client.debug.onBreakHit(event \-> {
    System.out.printf(\(dqbreak: line %d, %s%n\(dq, event.line, event.command);
});
.EE
.SH CHAN_PTY (5) \(en Pseudo\-terminal I/O
CHAN_PTY spawns an interactive Bash session in a pseudo\-terminal and
relays I/O between the client and the PTY.
It uses request/response for spawn, resize, signal, and close, and
server\-push for output and exit events.
.PP
\f[B]Spawn:\f[R]
.PP
Python:
.IP
.EX
info = \f[B]await\f[R] client.pty.spawn(rows=24, cols=80, strip_ansi=True)
.EE
.PP
TypeScript:
.IP
.EX
\f[B]const\f[R] info = \f[B]await\f[R] client.pty.spawn({ rows: 24, cols: 80, stripAnsi: \f[B]true\f[R] });
.EE
.PP
C:
.IP
.EX
bc_pty_info_t info;
bc_pty_spawn(c, 24, 80, \(dq/bin/bash\(dq, 1, &info);
.EE
.PP
Java:
.IP
.EX
PtyInfo info = client.pty.spawn(24, 80, \(dq/bin/bash\(dq, \f[B]true\f[R]);
.EE
.PP
The spawn response includes the PTY\(cqs \f[CR]pid\f[R], actual
\f[CR]rows\f[R] and \f[CR]cols\f[R], and the \f[CR]strip_ansi\f[R]
setting.
.PP
\f[B]I/O relay:\f[R]
.PP
Client\-to\-PTY input is sent as base64\-encoded data:
.PP
Python:
.IP
.EX
\f[B]await\f[R] client.pty.write_input(\(dqls \-la\(rsn\(dq)
.EE
.PP
TypeScript:
.IP
.EX
\f[B]await\f[R] client.pty.writeInput(\(dqls \-la\(rsn\(dq);
.EE
.PP
C:
.IP
.EX
bc_pty_write(c, \(dqls \-la\(rsn\(dq, 7);
.EE
.PP
Java:
.IP
.EX
client.pty.writeInput(\(dqls \-la\(rsn\(dq);
.EE
.PP
PTY\-to\-client output arrives as \f[CR]output\f[R] push events:
.PP
Python:
.IP
.EX
client.pty.on(\(dqoutput\(dq, \f[B]lambda\f[R] data: print(data, end=\(dq\(dq))
.EE
.PP
TypeScript:
.IP
.EX
client.pty.on(\(dqoutput\(dq, (data: string) \f[B]=>\f[R] process.stdout.write(data));
.EE
.PP
C:
.IP
.EX
void on_out(const char *data, size_t len, void *ud) {
    fwrite(data, 1, len, stdout);
}
bc_pty_on_output(c, on_out, NULL);
.EE
.PP
Java:
.IP
.EX
client.pty.onOutput((data, len) \-> System.out.print(\f[B]new\f[R] String(data, 0, len)));
.EE
.PP
\f[B]Resize, signal, close:\f[R]
.PP
Python:
.IP
.EX
\f[B]await\f[R] client.pty.resize(rows=48, cols=120)
\f[B]await\f[R] client.pty.signal(\(dqSIGINT\(dq)
\f[B]await\f[R] client.pty.close()
.EE
.PP
TypeScript:
.IP
.EX
\f[B]await\f[R] client.pty.resize(48, 120);
\f[B]await\f[R] client.pty.signal(\(dqSIGINT\(dq);
\f[B]await\f[R] client.pty.close();
.EE
.PP
C:
.IP
.EX
bc_pty_resize(c, 48, 120);
bc_pty_signal(c, \(dqSIGINT\(dq);
bc_pty_close(c);
.EE
.PP
Java:
.IP
.EX
client.pty.resize(48, 120);
client.pty.signal(\(dqSIGINT\(dq);
client.pty.close();
.EE
.PP
\f[B]Exit notification:\f[R]
.PP
When the PTY child process exits, the server sends an \f[CR]exit\f[R]
push message with the exit code:
.PP
Python:
.IP
.EX
client.pty.on(\(dqexit\(dq, \f[B]lambda\f[R] code: print(f\(dqexited: {code}\(dq))
.EE
.PP
TypeScript:
.IP
.EX
client.pty.on(\(dqexit\(dq, (code: number) \f[B]=>\f[R] console.log(\(gaexited: ${code}\(ga));
.EE
.PP
C:
.IP
.EX
void on_exit(int code, void *ud) { printf(\(dqexited: %d\(rsn\(dq, code); }
bc_pty_on_exit(c, on_exit, NULL);
.EE
.PP
Java:
.IP
.EX
client.pty.onExit(code \-> System.out.println(\(dqexited: \(dq + code));
.EE
