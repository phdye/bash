.IP
.EX
\f[I]// Simple eval (convenience on client)\f[R]
result, err := client.Eval(ctx, \(dqecho hello\(dq)
fmt.Println(result.Stdout)    \f[I]// \(dqhello\(rsn\(dq\f[R]
fmt.Println(result.Stderr)    \f[I]// \(dq\(dq\f[R]
fmt.Println(result.ExitCode)  \f[I]// 0\f[R]

