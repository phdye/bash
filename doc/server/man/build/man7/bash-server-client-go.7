.SH Complete example
.IP
.EX
\f[B]package\f[R] main

\f[B]import\f[R] (
    \(dqcontext\(dq
    \(dqfmt\(dq
    \(dqlog\(dq
    \(dqtime\(dq

    \(dqgithub.com/cygwin/bash\-server/clients/go/bashclient\(dq
)

\f[B]func\f[R] main() {
    ctx := context.Background()

    client, err := bashclient.Connect(ctx, \(dq/tmp/bash\-server\-1000/sock\(dq)
    \f[B]if\f[R] err != nil {
        log.Fatal(err)
    }
    \f[B]defer\f[R] client.Close()

    \f[I]// Authenticate\f[R]
    \f[B]if\f[R] err := client.Auth(ctx, \(dqabcdef0123456789...\(dq); err != nil {
        log.Fatal(err)
    }

    \f[I]// Simple command\f[R]
    result, err := client.Eval(ctx, \(dqecho hello world\(dq)
    \f[B]if\f[R] err != nil {
        log.Fatal(err)
    }
    fmt.Print(result.Stdout)

    \f[I]// Set and read a variable\f[R]
    \f[B]if\f[R] err := client.State.SetVar(ctx, \(dqGREETING\(dq, \(dqhello\(dq, nil); err != nil {
        log.Fatal(err)
    }
    info, err := client.State.GetVar(ctx, \(dqGREETING\(dq)
    \f[B]if\f[R] err != nil {
        log.Fatal(err)
    }
    fmt.Println(info.Value) \f[I]// \(dqhello\(dq\f[R]

    \f[I]// Observe\f[R]
    \f[B]var\f[R] events []bashclient.PostCommandEvent
    client.Observe.OnPostCommand(\f[B]func\f[R](e bashclient.PostCommandEvent) {
        events = append(events, e)
    })
    \f[B]if\f[R] err := client.Observe.Subscribe(ctx, 1); err != nil {
        log.Fatal(err)
    }
    client.Eval(ctx, \(dqtrue\(dq)

    \f[I]// Brief pause for push events\f[R]
    time.Sleep(100 * time.Millisecond)
    fmt.Printf(\(dqCaptured %d events\(rsn\(dq, len(events))
}
.EE
.SH Comparison with other bindings
The Go binding is most similar to the Python binding in its concurrency
model (background reader, non\-blocking dispatch), but uses goroutines
and channels instead of an event loop:
