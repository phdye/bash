.IP
.EX
\f[I]// Subscribe\f[R]
err := client.Observe.Subscribe(ctx, 1)

\f[I]// Register callbacks (function values)\f[R]
client.Observe.OnPreCommand(\f[B]func\f[R](event bashclient.PreCommandEvent) {
    fmt.Printf(\(dq[%d] running: %s in %s\(rsn\(dq, event.Seq, event.Command, event.Cwd)
