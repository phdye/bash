.SH CONTROL channel (channel 0)
.IP
.EX
\f[I]// Authenticate\f[R]
\f[B]await\f[R] client.auth(token);

\f[I]// Ping\f[R]
\f[B]await\f[R] client.ping();

\f[I]// Configure\f[R]
\f[B]await\f[R] client.control.configure({ observe_level: 1 });

\f[I]// Disconnect\f[R]
\f[B]await\f[R] client.control.disconnect();
.EE
.SH COMMAND channel (channel 1)
.IP
.EX
\f[I]// Simple eval\f[R]
\f[B]const\f[R] result = \f[B]await\f[R] client.eval(\(dqecho hello\(dq);
console.log(result.stdout);    \f[I]// \(dqhello\(rsn\(dq\f[R]
console.log(result.stderr);    \f[I]// \(dq\(dq\f[R]
console.log(result.exit_code); \f[I]// 0\f[R]

\f[I]// With timeout (milliseconds)\f[R]
\f[B]const\f[R] result2 = \f[B]await\f[R] client.eval(\(dqsleep 2 && echo done\(dq, 10000);

\f[I]// Via channel object\f[R]
\f[B]const\f[R] result3 = \f[B]await\f[R] client.command.eval(\(dqls \-la\(dq, { timeout: 5000 });
.EE
.SH STATE channel (channel 2)
.IP
.EX
\f[I]// Variables\f[R]
\f[B]const\f[R] info = \f[B]await\f[R] client.state.getVar(\(dqHOME\(dq);
console.log(info.value);        \f[I]// \(dq/home/user\(dq\f[R]
console.log(info.attributes);   \f[I]// []\f[R]

\f[B]await\f[R] client.state.setVar(\(dqMY_VAR\(dq, \(dqhello\(dq, [\(dq\-x\(dq]);
\f[B]await\f[R] client.state.unsetVar(\(dqMY_VAR\(dq);

\f[I]// Functions\f[R]
\f[B]const\f[R] func = \f[B]await\f[R] client.state.getFunc(\(dqmy_function\(dq);
console.log(func.definition);

\f[B]await\f[R] client.state.unsetFunc(\(dqmy_function\(dq);

\f[I]// Aliases\f[R]
\f[B]const\f[R] alias = \f[B]await\f[R] client.state.getAlias(\(dqll\(dq);
\f[B]await\f[R] client.state.setAlias(\(dqll\(dq, \(dqls \-la \-\-color\(dq);
\f[B]await\f[R] client.state.unsetAlias(\(dqll\(dq);

\f[I]// Traps\f[R]
\f[B]await\f[R] client.state.setTrap(\(dqSIGINT\(dq, \(dqecho interrupted\(dq);
\f[B]await\f[R] client.state.unsetTrap(\(dqSIGINT\(dq);

\f[I]// Inspect\f[R]
\f[B]const\f[R] items = \f[B]await\f[R] client.state.inspect(\(dqvariables\(dq);
.EE
.SH OBSERVE channel (channel 3)
.IP
.EX
\f[I]// Subscribe\f[R]
\f[B]await\f[R] client.observe.subscribe(1);

\f[I]// Register callbacks (EventEmitter\-style)\f[R]
client.observe.on(\(dqpre_command\(dq, (event: PreCommandEvent) \f[B]=>\f[R] {
    console.log(\(ga[${event.seq}] running: ${event.command}\(ga);
});

client.observe.on(\(dqpost_command\(dq, (event: PostCommandEvent) \f[B]=>\f[R] {
    console.log(\(ga[${event.seq}] done: exit=${event.exit_status}\(ga);
});

\f[I]// Execute commands \-\- callbacks fire automatically\f[R]
\f[B]await\f[R] client.eval(\(dqecho hello\(dq);

\f[I]// Unregister\f[R]
client.observe.off(\(dqpre_command\(dq, myCallback);
client.observe.off(\(dqpost_command\(dq);  \f[I]// remove all\f[R]

\f[I]// Unsubscribe\f[R]
\f[B]await\f[R] client.observe.unsubscribe();
.EE
.SH DEBUG channel (channel 4)
.IP
.EX
\f[I]// Enable\f[R]
\f[B]await\f[R] client.debug.enable();

\f[I]// Status\f[R]
\f[B]const\f[R] status = \f[B]await\f[R] client.debug.status();
console.log(\(gaactive=${status.active} mode=${status.mode}\(ga);

\f[I]// Breakpoints\f[R]
\f[B]const\f[R] bpId = \f[B]await\f[R] client.debug.addBreakpoint(\(dqcommand\(dq, { pattern: \(dqecho*\(dq });
\f[B]const\f[R] bpId2 = \f[B]await\f[R] client.debug.addBreakpoint(\(dqline\(dq, { line: 10 });

\f[B]const\f[R] bps = \f[B]await\f[R] client.debug.listBreakpoints();
\f[B]for\f[R] (\f[B]const\f[R] bp \f[B]of\f[R] bps) {
    console.log(\(ga#${bp.id} ${bp.kind} hits=${bp.hit_count}\(ga);
}

\f[I]// Break handler\f[R]
client.debug.on(\(dqbreak_hit\(dq, \f[B]async\f[R] (event: BreakHitEvent) \f[B]=>\f[R] {
    console.log(\(gabreak at line ${event.line}: ${event.command}\(ga);
    \f[B]const\f[R] ast = \f[B]await\f[R] client.debug.inspectAst();
    \f[B]await\f[R] client.debug.step();
});

\f[I]// Execution control\f[R]
\f[B]await\f[R] client.debug.continue();
\f[B]await\f[R] client.debug.step();
\f[B]await\f[R] client.debug.next();
\f[B]await\f[R] client.debug.finish();
\f[B]await\f[R] client.debug.skip();

\f[I]// Remove/toggle breakpoints\f[R]
\f[B]await\f[R] client.debug.removeBreakpoint(bpId);
\f[B]await\f[R] client.debug.disableBreakpoint(bpId2);
\f[B]await\f[R] client.debug.enableBreakpoint(bpId2);

\f[I]// Disable debugger\f[R]
\f[B]await\f[R] client.debug.disable();
.EE
.SH PTY channel (channel 5)
.IP
.EX
\f[I]// Spawn\f[R]
\f[B]const\f[R] info = \f[B]await\f[R] client.pty.spawn({ rows: 24, cols: 80, stripAnsi: \f[B]true\f[R] });
console.log(\(gaPTY pid=${info.pid}\(ga);

\f[I]// Output callbacks\f[R]
client.pty.on(\(dqoutput\(dq, (data: string) \f[B]=>\f[R] {
    process.stdout.write(data);
});

client.pty.on(\(dqexit\(dq, (exitCode: number) \f[B]=>\f[R] {
    console.log(\(ga\(rsnPTY exited: ${exitCode}\(ga);
});

\f[I]// Input\f[R]
\f[B]await\f[R] client.pty.writeInput(\(dqls \-la\(rsn\(dq);

\f[I]// Resize\f[R]
\f[B]await\f[R] client.pty.resize(48, 120);

\f[I]// Signal\f[R]
\f[B]await\f[R] client.pty.signal(\(dqSIGINT\(dq);

\f[I]// Close\f[R]
\f[B]await\f[R] client.pty.close();
.EE
.SH Callback model
The observe, debug, and PTY channels use an EventEmitter\-style
\f[CR]on\f[R]/\f[CR]off\f[R] pattern:
.IP
.EX
\f[I]// Register\f[R]
channel.on(\(dqevent_name\(dq, callback);

\f[I]// Unregister specific\f[R]
channel.off(\(dqevent_name\(dq, callback);

\f[I]// Unregister all for event\f[R]
channel.off(\(dqevent_name\(dq);
.EE
.PP
Callbacks are always synchronous functions.
If async work is needed, the callback can return a Promise, but it will
not be awaited by the dispatcher \(en use \f[CR].then()\f[R] or
\f[CR]void\f[R] async functions.
.PP
Multiple callbacks per event are supported and invoked in registration
order.
.SH Timeout handling
All request/response operations use a default timeout of 30 seconds
(30000 ms).
Timeouts are implemented with \f[CR]setTimeout\f[R] and automatically
clean up the Promise queue entry on expiry.
.PP
Override timeouts per\-call:
.IP
.EX
\f[I]// eval with 10\-second timeout\f[R]
\f[B]const\f[R] result = \f[B]await\f[R] client.eval(\(dqslow\-command\(dq, 10000);

\f[I]// channel\-level timeout\f[R]
\f[B]const\f[R] info = \f[B]await\f[R] client.state.getVar(\(dqHOME\(dq);  \f[I]// uses default 30s\f[R]
.EE
.PP
When a timeout fires, the pending Promise is rejected with
\f[CR]TimeoutError\f[R] and removed from the channel queue.
