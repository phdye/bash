} \f[B]from\f[R] \(dqbashclient\(dq;
.EE
.SH Complete example
.IP
.EX
\f[B]import\f[R] { BashClient } \f[B]from\f[R] \(dqbashclient\(dq;

\f[B]async\f[R] \f[B]function\f[R] main() {
    \f[B]const\f[R] client = \f[B]await\f[R] BashClient.connect(\(dq/tmp/bash\-server\-1000/sock\(dq);
    \f[B]try\f[R] {
        \f[B]await\f[R] client.auth(\(dqabcdef0123456789...\(dq);

        \f[I]// Simple command\f[R]
        \f[B]const\f[R] result = \f[B]await\f[R] client.eval(\(dqecho hello world\(dq);
        console.log(result.stdout);

        \f[I]// Set and read a variable\f[R]
        \f[B]await\f[R] client.state.setVar(\(dqGREETING\(dq, \(dqhello\(dq);
        \f[B]const\f[R] info = \f[B]await\f[R] client.state.getVar(\(dqGREETING\(dq);
        console.log(info.value);  \f[I]// \(dqhello\(dq\f[R]

        \f[I]// Observe\f[R]
        \f[B]const\f[R] events: PostCommandEvent[] = [];
        client.observe.on(\(dqpost_command\(dq, (e) \f[B]=>\f[R] events.push(e));
        \f[B]await\f[R] client.observe.subscribe();
        \f[B]await\f[R] client.eval(\(dqtrue\(dq);

        \f[I]// Wait briefly for push events\f[R]
        \f[B]await\f[R] \f[B]new\f[R] Promise(r \f[B]=>\f[R] setTimeout(r, 100));
        console.log(\(gaCaptured ${events.length} events\(ga);
    } \f[B]finally\f[R] {
        \f[B]await\f[R] client.close();
    }
}

main().catch(console.error);
.EE
