.SH OBSERVE channel
.IP
.EX
\f[I]/* Subscribe */\f[R]
bc_observe_subscribe(c, 1);

\f[I]/* Register callbacks */\f[R]
void on_pre(const bc_pre_command_event_t *event, void *userdata) {
    printf(\(dq[%d] running: %s in %s\(rsn\(dq,
           event\->seq, event\->command, event\->cwd);
}

void on_post(const bc_post_command_event_t *event, void *userdata) {
    printf(\(dq[%d] done: %s exit=%d duration=%dms\(rsn\(dq,
           event\->seq, event\->command,
           event\->exit_status, event\->duration_ms);
}

bc_observe_on_pre_command(c, on_pre, NULL);
bc_observe_on_post_command(c, on_post, NULL);

\f[I]/* Poll for events (non\-blocking) */\f[R]
int processed = bc_poll(c, 0);

\f[I]/* Poll with timeout (blocks up to 1000ms) */\f[R]
processed = bc_poll(c, 1000);

\f[I]/* Unsubscribe */\f[R]
bc_observe_unsubscribe(c);
.EE
.PP
The event structs:
.IP
.EX
\f[B]typedef\f[R] \f[B]struct\f[R] {
    int seq;
    long long timestamp;
    char *command;
    char *cwd;
    int line_number;
    int is_subshell;
    int is_async;
} bc_pre_command_event_t;

\f[B]typedef\f[R] \f[B]struct\f[R] {
    int seq;
    long long timestamp;
    char *command;
    int exit_status;
    int signal_number;
    int duration_ms;
} bc_post_command_event_t;
.EE
.PP
Event data (strings) within callback arguments is valid only for the
duration of the callback.
Copy any data you need to retain.
.SH DEBUG channel
.IP
.EX
\f[I]/* Enable/disable */\f[R]
bc_debug_enable(c);
bc_debug_disable(c);

\f[I]/* Status */\f[R]
bc_debug_status_t status;
bc_debug_status(c, &status);
printf(\(dqactive=%d mode=%s bps=%d\(rsn\(dq,
       status.active, status.mode, status.breakpoints);
bc_debug_status_free(&status);

\f[I]/* Add breakpoints */\f[R]
int bp_id = bc_debug_add_breakpoint(c, \(dqcommand\(dq, \(dqecho*\(dq, \-1, NULL);
int bp_id2 = bc_debug_add_breakpoint(c, \(dqline\(dq, NULL, 10, NULL);
int bp_id3 = bc_debug_add_breakpoint(c, \(dqfunction\(dq, \(dqmy_func\(dq, \-1, NULL);

\f[I]/* List breakpoints */\f[R]
bc_breakpoint_t *bps;
int count;
bc_debug_list_breakpoints(c, &bps, &count);
\f[B]for\f[R] (int i = 0; i < count; i++) {
    printf(\(dq#%d %s enabled=%d hits=%d\(rsn\(dq,
           bps[i].id, bps[i].kind,
           bps[i].enabled, bps[i].hit_count);
}
bc_breakpoint_list_free(bps, count);

\f[I]/* Break hit callback */\f[R]
void on_break(const bc_break_hit_event_t *event, void *userdata) {
    printf(\(dqbreak at line %d: %s (depth %d)\(rsn\(dq,
           event\->line, event\->command, event\->depth);
}
bc_debug_on_break_hit(c, on_break, NULL);

\f[I]/* Execution control */\f[R]
bc_debug_continue(c);
bc_debug_step(c);
bc_debug_next(c);
bc_debug_finish(c);
bc_debug_skip(c);

\f[I]/* Inspect AST */\f[R]
char *json_ast;
bc_debug_inspect_ast(c, &json_ast);
printf(\(dq%s\(rsn\(dq, json_ast);
bc_free(json_ast);

\f[I]/* Remove breakpoint */\f[R]
bc_debug_remove_breakpoint(c, bp_id);
.EE
.PP
The breakpoint struct:
.IP
.EX
\f[B]typedef\f[R] \f[B]struct\f[R] {
    int id;
    char *kind;        \f[I]/* \(dqcommand\(dq, \(dqline\(dq, \(dqfunction\(dq */\f[R]
    int enabled;
    int hit_count;
    char *pattern;     \f[I]/* may be NULL */\f[R]
    int line;          \f[I]/* \-1 if not line\-based */\f[R]
    char *condition;   \f[I]/* may be NULL */\f[R]
} bc_breakpoint_t;
.EE
.SH PTY channel
.IP
.EX
\f[I]/* Spawn */\f[R]
bc_pty_info_t info;
bc_pty_spawn(c, 24, 80, \(dq/bin/bash\(dq, 0, &info);
printf(\(dqpid=%d %dx%d\(rsn\(dq, info.pid, info.rows, info.cols);

\f[I]/* Output callback */\f[R]
void on_output(const char *data, size_t len, void *userdata) {
    fwrite(data, 1, len, stdout);
}

void on_exit(int exit_code, void *userdata) {
    printf(\(dq\(rsnPTY exited: %d\(rsn\(dq, exit_code);
}

bc_pty_on_output(c, on_output, NULL);
bc_pty_on_exit(c, on_exit, NULL);

\f[I]/* Write input */\f[R]
bc_pty_write(c, \(dqls \-la\(rsn\(dq, 7);

\f[I]/* Resize */\f[R]
bc_pty_resize(c, 48, 120);

\f[I]/* Signal */\f[R]
bc_pty_signal(c, \(dqSIGINT\(dq);

\f[I]/* Close */\f[R]
bc_pty_close(c);
.EE
.PP
The PTY info struct:
.IP
.EX
\f[B]typedef\f[R] \f[B]struct\f[R] {
    int rows;
    int cols;
    int pid;
    int strip_ansi;
} bc_pty_info_t;
.EE
.SH Polling
Since the C binding has no background thread, server\-push messages must
be processed explicitly via \f[CR]bc_poll()\f[R]:
.IP
.EX
\f[I]/* Non\-blocking poll \-\- returns immediately */\f[R]
int n = bc_poll(c, 0);
printf(\(dqprocessed %d push messages\(rsn\(dq, n);

\f[I]/* Blocking poll \-\- waits up to 1000ms */\f[R]
n = bc_poll(c, 1000);

\f[I]/* Typical poll loop */\f[R]
\f[B]while\f[R] (running) {
    int n = bc_poll(c, 100);  \f[I]/* 100ms timeout */\f[R]
    \f[I]/* do other work ... */\f[R]
}
.EE
.PP
\f[CR]bc_poll()\f[R] reads available data from the transport, decodes
any complete NDJSON lines, and dispatches server\-push messages to
registered callbacks.
It returns the number of messages processed.
.PP
A timeout of 0 performs a non\-blocking check.
A positive timeout blocks up to that many milliseconds waiting for data.
.SH Callback model
Callbacks are registered as C function pointers with an optional
\f[CR]void *userdata\f[R] parameter:
.IP
.EX
\f[I]/* Observe callbacks */\f[R]
\f[B]typedef\f[R] void (*bc_pre_command_cb)(const bc_pre_command_event_t *event,
                                  void *userdata);
\f[B]typedef\f[R] void (*bc_post_command_cb)(const bc_post_command_event_t *event,
                                   void *userdata);

\f[I]/* Debug callback */\f[R]
\f[B]typedef\f[R] void (*bc_break_hit_cb)(const bc_break_hit_event_t *event,
                                 void *userdata);

\f[I]/* PTY callbacks */\f[R]
\f[B]typedef\f[R] void (*bc_pty_output_cb)(const char *data, size_t len,
                                  void *userdata);
\f[B]typedef\f[R] void (*bc_pty_exit_cb)(int exit_code, void *userdata);
.EE
.PP
Each callback registration function takes the client handle, the
function pointer, and the userdata pointer:
.IP
.EX
bc_observe_on_pre_command(c, my_callback, my_context);
bc_debug_on_break_hit(c, my_break_handler, my_context);
bc_pty_on_output(c, my_output_handler, my_context);
.EE
.PP
Passing \f[CR]NULL\f[R] as the callback function unregisters the
callback.
Only one callback per event type can be active at a time (unlike the
Python/TypeScript/Java bindings which support multiple callbacks).
.SH Protocol limits
.IP
.EX
#define BC_FRAME_MAX_PAYLOAD  (1024 * 1024)  \f[I]/* 1 MB */\f[R]
#define BC_TOKEN_HEXLEN       64
#define BC_DEFAULT_TIMEOUT_MS 30000          \f[I]/* 30 seconds */\f[R]
.EE
