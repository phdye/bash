.SH Complete example
.IP
.EX
#include \f[B]<stdio.h>\f[R]
#include \f[B]<stdlib.h>\f[R]
#include \f[B]\(dqbashclient.h\(dq\f[R]

static void on_pre(const bc_pre_command_event_t *e, void *ud) {
    printf(\(dq>>> %s\(rsn\(dq, e\->command);
}

static void on_post(const bc_post_command_event_t *e, void *ud) {
    printf(\(dq<<< %s (exit %d, %dms)\(rsn\(dq,
           e\->command, e\->exit_status, e\->duration_ms);
}

int main(void) {
    bc_client_t *c = bc_connect(\(dq/tmp/bash\-server\-1000/sock\(dq);
    \f[B]if\f[R] (!c) { perror(\(dqconnect\(dq); \f[B]return\f[R] 1; }

    \f[B]if\f[R] (bc_auth(c, \(dqabcdef0123456789...\(dq) != BC_OK) {
        fprintf(stderr, \(dqauth: %s\(rsn\(dq, bc_error(c));
        bc_close(c);
        \f[B]return\f[R] 1;
    }

    \f[I]/* Simple eval */\f[R]
    bc_eval_result_t result;
    \f[B]if\f[R] (bc_eval(c, \(dqecho hello world\(dq, &result) == BC_OK) {
        printf(\(dqstdout: %s\(dq, result.stdout_data);
        bc_eval_result_free(&result);
    }

    \f[I]/* Set and read a variable */\f[R]
    bc_state_set_var(c, \(dqGREETING\(dq, \(dqhello\(dq, NULL, 0);
    bc_var_info_t info;
    \f[B]if\f[R] (bc_state_get_var(c, \(dqGREETING\(dq, &info) == BC_OK) {
        printf(\(dqGREETING=%s\(rsn\(dq, info.value);
        bc_var_info_free(&info);
    }

    \f[I]/* Observe */\f[R]
    bc_observe_on_pre_command(c, on_pre, NULL);
    bc_observe_on_post_command(c, on_post, NULL);
    bc_observe_subscribe(c, 1);

    bc_eval(c, \(dqtrue\(dq, &result);
    bc_eval_result_free(&result);

    bc_poll(c, 100);  \f[I]/* dispatch pending events */\f[R]

    bc_close(c);
    \f[B]return\f[R] 0;
}
.EE
