.SH Error handling
All errors inherit from \f[CR]BashClientError\f[R]:
.IP
.EX
BashClientError
    AuthError          \-\- Authentication failed
    ProtocolError      \-\- Malformed frame or message
    TimeoutError       \-\- Operation timed out
    TransportError     \-\- Socket or I/O error
    ServerError        \-\- Server returned error response
        .channel       \-\- Channel that produced the error
.EE
.PP
Standard \f[CR]try\f[R]/\f[CR]except\f[R] patterns apply:
.IP
.EX
\f[B]from\f[R] bashclient.errors \f[B]import\f[R] AuthError, TimeoutError, ServerError

\f[B]try\f[R]:
    \f[B]await\f[R] client.auth(wrong_token)
\f[B]except\f[R] AuthError:
    print(\(dqbad token\(dq)

\f[B]try\f[R]:
    result = \f[B]await\f[R] client.eval(\(dqsleep 60\(dq, timeout=5.0)
\f[B]except\f[R] TimeoutError:
    print(\(dqcommand timed out\(dq)

\f[B]try\f[R]:
    info = \f[B]await\f[R] client.state.get_var(\(dqNONEXISTENT\(dq)
\f[B]except\f[R] ServerError \f[B]as\f[R] e:
    print(f\(dqserver error on channel {e.channel}: {e}\(dq)
.EE
.SH CONTROL channel (channel 0)
Session lifecycle operations:
.IP
.EX
\f[I]# Authenticate\f[R]
\f[B]await\f[R] client.auth(token)

\f[I]# Ping/pong keepalive\f[R]
\f[B]await\f[R] client.ping()

\f[I]# Configure session (e.g., enable observe)\f[R]
\f[B]await\f[R] client.control.configure(observe_level=1)

\f[I]# Graceful disconnect\f[R]
\f[B]await\f[R] client.control.disconnect()
.EE
.SH COMMAND channel (channel 1)
Command evaluation with stdout/stderr capture:
.IP
.EX
\f[I]# Simple eval (convenience method on client)\f[R]
result = \f[B]await\f[R] client.eval(\(dqecho hello\(dq)
print(result.stdout)   \f[I]# \(dqhello\(rsn\(dq\f[R]
print(result.stderr)   \f[I]# \(dq\(dq\f[R]
print(result.exit_code) \f[I]# 0\f[R]

\f[I]# With custom timeout\f[R]
result = \f[B]await\f[R] client.eval(\(dqsleep 2 && echo done\(dq, timeout=10.0)

\f[I]# Via channel object directly\f[R]
result = \f[B]await\f[R] client.command.eval(\(dqls \-la\(dq, id=\(dqreq\-001\(dq)
.EE
.PP
The \f[CR]eval()\f[R] method collects three response messages
(\f[CR]stdout\f[R], \f[CR]stderr\f[R], \f[CR]complete\f[R]) and returns
an \f[CR]EvalResult\f[R] dataclass.
stdout and stderr payloads are automatically base64\-decoded.
.SH STATE channel (channel 2)
Direct manipulation of shell state across four namespaces:
.IP
.EX
\f[I]# Variables\f[R]
info = \f[B]await\f[R] client.state.get_var(\(dqHOME\(dq)
print(info.value)        \f[I]# \(dq/home/user\(dq\f[R]
print(info.attributes)   \f[I]# []\f[R]

\f[B]await\f[R] client.state.set_var(\(dqMY_VAR\(dq, \(dqhello\(dq, attributes=[\(dq\-x\(dq])
\f[B]await\f[R] client.state.unset_var(\(dqMY_VAR\(dq)

\f[I]# Functions\f[R]
func = \f[B]await\f[R] client.state.get_func(\(dqmy_function\(dq)
print(func.definition)

\f[B]await\f[R] client.state.unset_func(\(dqmy_function\(dq)

\f[I]# Aliases\f[R]
alias = \f[B]await\f[R] client.state.get_alias(\(dqll\(dq)
print(alias.value)       \f[I]# \(dqls \-la\(dq\f[R]

\f[B]await\f[R] client.state.set_alias(\(dqll\(dq, \(dqls \-la \-\-color\(dq)
\f[B]await\f[R] client.state.unset_alias(\(dqll\(dq)

\f[I]# Traps\f[R]
\f[B]await\f[R] client.state.set_trap(\(dqSIGINT\(dq, \(dqecho interrupted\(dq)
\f[B]await\f[R] client.state.unset_trap(\(dqSIGINT\(dq)

\f[I]# Inspect (list all items of a type)\f[R]
items = \f[B]await\f[R] client.state.inspect(\(dqvariables\(dq)
\f[B]for\f[R] item \f[B]in\f[R] items:
    print(f\(dq{item[\(aqname\(aq]}={item.get(\(aqvalue\(aq, \(aq\(aq)}\(dq)
.EE
.SH OBSERVE channel (channel 3)
Subscribe to pre/post command events with callbacks:
.IP
.EX
\f[I]# Subscribe at level 1\f[R]
\f[B]await\f[R] client.observe.subscribe(level=1)

\f[I]# Register callbacks (sync or async)\f[R]
\f[B]def\f[R] on_pre(event: PreCommandEvent):
    print(f\(dq[{event.seq}] running: {event.command} in {event.cwd}\(dq)

\f[B]async\f[R] \f[B]def\f[R] on_post(event: PostCommandEvent):
    print(f\(dq[{event.seq}] done: {event.command} exit={event.exit_status} \(dq
          f\(dqduration={event.duration_ms}ms\(dq)

client.observe.on(\(dqpre_command\(dq, on_pre)
client.observe.on(\(dqpost_command\(dq, on_post)

\f[I]# Execute commands \-\- callbacks fire automatically\f[R]
\f[B]await\f[R] client.eval(\(dqecho hello\(dq)
\f[B]await\f[R] client.eval(\(dqls /nonexistent\(dq)

\f[I]# Unregister a specific callback\f[R]
client.observe.off(\(dqpre_command\(dq, on_pre)

\f[I]# Unregister all callbacks for an event type\f[R]
client.observe.off(\(dqpost_command\(dq)

\f[I]# Unsubscribe\f[R]
\f[B]await\f[R] client.observe.unsubscribe()
.EE
.PP
Both synchronous and async callbacks are supported.
The dispatch method detects coroutine functions and awaits them
automatically.
.SH DEBUG channel (channel 4)
Interactive debugging with breakpoints, stepping, and AST inspection:
.IP
.EX
\f[I]# Enable debugger\f[R]
\f[B]await\f[R] client.debug.enable()

\f[I]# Check status\f[R]
status = \f[B]await\f[R] client.debug.status()
print(f\(dqactive={status.active} mode={status.mode}\(dq)

\f[I]# Add breakpoints\f[R]
bp_id = \f[B]await\f[R] client.debug.add_breakpoint(\(dqcommand\(dq, pattern=\(dqecho*\(dq)
bp_id2 = \f[B]await\f[R] client.debug.add_breakpoint(\(dqline\(dq, line=10)
bp_id3 = \f[B]await\f[R] client.debug.add_breakpoint(\(dqfunction\(dq, pattern=\(dqmy_func\(dq)

\f[I]# List breakpoints\f[R]
bps = \f[B]await\f[R] client.debug.list_breakpoints()
\f[B]for\f[R] bp \f[B]in\f[R] bps:
    print(f\(dq#{bp.id} {bp.kind} hits={bp.hit_count} enabled={bp.enabled}\(dq)

\f[I]# Register break_hit callback\f[R]
\f[B]async\f[R] \f[B]def\f[R] on_break(event: BreakHitEvent):
    print(f\(dqbreak at line {event.line}: {event.command}\(dq)
    ast = \f[B]await\f[R] client.debug.inspect_ast()
    print(f\(dqAST: {ast}\(dq)
    \f[B]await\f[R] client.debug.step()

client.debug.on(\(dqbreak_hit\(dq, on_break)

\f[I]# Execution control\f[R]
\f[B]await\f[R] client.debug.continue_()   \f[I]# note trailing underscore\f[R]
\f[B]await\f[R] client.debug.step()
\f[B]await\f[R] client.debug.next()
\f[B]await\f[R] client.debug.finish()
\f[B]await\f[R] client.debug.skip()

\f[I]# Inspect AST at current break point\f[R]
ast = \f[B]await\f[R] client.debug.inspect_ast()

\f[I]# Remove breakpoint\f[R]
\f[B]await\f[R] client.debug.remove_breakpoint(bp_id)

\f[I]# Enable/disable without removing\f[R]
\f[B]await\f[R] client.debug.disable_breakpoint(bp_id2)
\f[B]await\f[R] client.debug.enable_breakpoint(bp_id2)

\f[I]# Disable debugger\f[R]
\f[B]await\f[R] client.debug.disable()
.EE
.PP
Note that \f[CR]continue_()\f[R] has a trailing underscore to avoid
conflicting with the Python \f[CR]continue\f[R] keyword.
.SH PTY channel (channel 5)
Pseudo\-terminal spawning and interactive I/O:
.IP
.EX
\f[I]# Spawn a PTY\f[R]
info = \f[B]await\f[R] client.pty.spawn(rows=24, cols=80, strip_ansi=True)
print(f\(dqPTY pid={info.pid} {info.rows}x{info.cols}\(dq)

\f[I]# Register output callback\f[R]
\f[B]def\f[R] on_output(data: str):
    print(data, end=\(dq\(dq)

\f[B]def\f[R] on_exit(exit_code: int):
    print(f\(dq\(rsnPTY exited with code {exit_code}\(dq)

client.pty.on(\(dqoutput\(dq, on_output)
client.pty.on(\(dqexit\(dq, on_exit)

\f[I]# Send input (automatically base64\-encoded)\f[R]
\f[B]await\f[R] client.pty.write_input(\(dqls \-la\(rsn\(dq)

\f[I]# Resize terminal\f[R]
\f[B]await\f[R] client.pty.resize(rows=48, cols=120)

\f[I]# Send signal\f[R]
\f[B]await\f[R] client.pty.signal(\(dqSIGINT\(dq)

\f[I]# Close PTY\f[R]
\f[B]await\f[R] client.pty.close()
.EE
.PP
PTY output is automatically base64\-decoded.
When \f[CR]strip_ansi=True\f[R] is set during spawn, ANSI escape
sequences are removed server\-side before transmission.
.SH Callback model
The observe, debug, and PTY channels use an \f[CR]on\f[R]/\f[CR]off\f[R]
callback registration pattern:
.IP
.EX
\f[I]# Register\f[R]
channel.on(\(dqevent_name\(dq, callback)

\f[I]# Unregister specific callback\f[R]
channel.off(\(dqevent_name\(dq, callback)

\f[I]# Unregister all callbacks for an event\f[R]
channel.off(\(dqevent_name\(dq)
.EE
.PP
Callbacks can be either synchronous functions or async coroutines.
The dispatch system detects coroutine functions with
\f[CR]asyncio.iscoroutinefunction()\f[R] and awaits them when
appropriate.
.PP
Multiple callbacks can be registered for the same event.
They are invoked in registration order.
.SH Properties
The client exposes two read\-only properties:
.IP
.EX
client.is_connected      \f[I]# True if transport is open\f[R]
client.is_authenticated  \f[I]# True if auth() succeeded\f[R]
.EE
.SH Constants
Channel IDs and protocol limits are available as module\-level
constants:
.IP
.EX
\f[B]from\f[R] bashclient.types \f[B]import\f[R] (
    CHAN_CONTROL,          \f[I]# 0\f[R]
    CHAN_COMMAND,          \f[I]# 1\f[R]
    CHAN_STATE,            \f[I]# 2\f[R]
    CHAN_OBSERVE,          \f[I]# 3\f[R]
    CHAN_DEBUG,            \f[I]# 4\f[R]
    CHAN_PTY,              \f[I]# 5\f[R]
    FRAME_MAX_PAYLOAD,    \f[I]# 1048576 (1 MB)\f[R]
    TOKEN_HEXLEN,         \f[I]# 64\f[R]
    OBSERVE_LEVEL_OFF,    \f[I]# 0\f[R]
    OBSERVE_LEVEL_COMMAND, \f[I]# 1\f[R]
)
.EE
.SH Complete example
.IP
.EX
\f[B]import\f[R] asyncio
\f[B]from\f[R] bashclient \f[B]import\f[R] BashClient

\f[B]async\f[R] \f[B]def\f[R] main():
    \f[B]async\f[R] \f[B]with\f[R] BashClient.connect(\(dq/tmp/bash\-server\-1000/sock\(dq) \f[B]as\f[R] client:
        \f[I]# Authenticate\f[R]
        \f[B]await\f[R] client.auth(\(dqabcdef0123456789...\(dq)

        \f[I]# Simple command\f[R]
        result = \f[B]await\f[R] client.eval(\(dqecho hello world\(dq)
        \f[B]assert\f[R] result.exit_code == 0
        print(result.stdout)

        \f[I]# Set and read a variable\f[R]
        \f[B]await\f[R] client.state.set_var(\(dqGREETING\(dq, \(dqhello\(dq)
        info = \f[B]await\f[R] client.state.get_var(\(dqGREETING\(dq)
        \f[B]assert\f[R] info.value == \(dqhello\(dq

        \f[I]# Subscribe to observations\f[R]
        events = []
        client.observe.on(\(dqpost_command\(dq, \f[B]lambda\f[R] e: events.append(e))
        \f[B]await\f[R] client.observe.subscribe()
        \f[B]await\f[R] client.eval(\(dqtrue\(dq)
        \f[B]await\f[R] asyncio.sleep(0.1)
        print(f\(dqCaptured {len(events)} events\(dq)

asyncio.run(main())
.EE
